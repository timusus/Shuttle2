# Built application files
*.apk
*.aab
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/*
.DS_Store

# Keystore files
# Uncomment the following line if you do not want to check your keystore files in.
#*.jks
android/app/keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Deployment secrets
android/app/deployment_keys.json
# App Store Connect API keys live in ~/.secrets, read by absolute path; never in the tree
*.p8
AuthKey_*
asc.env
.secrets/

# Freeline
freeline.py
freeline/
freeline_project_description.json

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Native
cmake-compiler-settings/
.cxx/

# Version control
vcs.xml

# Temp translation files
/.translations/temp/

# Claude Code session scratch — worktrees, ADB captures, handover notes
.claude/worktrees/
.claude/WHERE-WE-LEFT-OFF.md
.adb-screenshots/
tmp/
support/reviews/
__pycache__/
.claude/longjobs/
.claude/land-logs/
.claude/ios-install.pid
.claude/ios-installed-sha

# iOS screenshot output (ios-simulator / ios-device skills)
.ios-screenshots/
.ios-device-screenshots/

# design-shots.sh output
shots/
# ...but the website's screenshots are site assets
!website/assets/shots/
