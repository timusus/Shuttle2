#!/usr/bin/env bash

set -eu
set -o pipefail

if [ "${VERBOSE:-0}" = "1" ]; then
  set -x
fi

# Overridable Environment
BUILD_PATH=${BUILD_PATH:-build}
CONFIGURATION=${CONFIGURATION:-Debug}
RESULT_PATH=${RESULT_PATH:-${BUILD_PATH}/Artifacts}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Set by run_changed_mode; cleaned up by finish() on exit.
WORK_DIR=""

# build-brief condenses Gradle's console output (a 400+ line log becomes a
# handful of lines) while keeping the exit code and, for compile failures,
# the file:line and message; fall back to plain ./gradlew when it's not on
# PATH.
GRADLE_RUNNER=(./gradlew)
if command -v build-brief >/dev/null 2>&1; then
  GRADLE_RUNNER=(build-brief ./gradlew)
fi
# A leading --remote-build (or S2_REMOTE_BUILD=1) runs Gradle through
# remote-build.sh, which builds on the Mac unless it's loaded, else on the WSL
# box, syncing the test results back here (#451, #546).
if [ "${1:-}" = "--remote-build" ]; then S2_REMOTE_BUILD=1; shift; fi
if [ "${S2_REMOTE_BUILD:-0}" = "1" ]; then
  GRADLE_RUNNER=("${SCRIPT_DIR}/remote-build.sh")
fi

# Parse the TEST-*.xml files written since ${marker} and print each failed/
# errored testcase's class.method and the first line of its failure message
# (see #334, #468), via the helper shared with remote-build.sh.
report_test_failures() {
  local marker="$1"
  "${SCRIPT_DIR}/report-test-failures.sh" "${marker}" "${REPO_ROOT}"
}

# Run Gradle (via build-brief when available), retry once with plain
# ./gradlew if build-brief's own output parser breaks (see #335), then
# report any failed testcases found in fresh TEST-*.xml files (see #334).
# Preserves Gradle's exit code.
run_and_report() {
  local marker outfile rc
  marker="$(mktemp -t unit-test-marker)"
  outfile="$(mktemp -t unit-test-output)"

  set +e
  "${GRADLE_RUNNER[@]}" "$@" 2>&1 | tee "${outfile}"
  rc=${PIPESTATUS[0]}
  set -e

  # Only a tool flake if no fresh TEST-*.xml records a failure: a real test
  # failure can mention these exceptions too, and must not trigger a re-run.
  if [ "${rc}" -ne 0 ] && [ "${GRADLE_RUNNER[0]}" = "build-brief" ] \
      && grep -qE 'EOFException|NoSuchFileException' "${outfile}" \
      && ! find "${REPO_ROOT}" -path '*/build/test-results/*/TEST-*.xml' -newer "${marker}" \
        -exec grep -lqE '<(failure|error)[ >]' {} + 2>/dev/null; then
    echo "build-brief's output parser failed (EOFException/NoSuchFileException, not a test failure); re-running with plain ./gradlew" >&2
    set +e
    ./gradlew "$@" 2>&1 | tee "${outfile}"
    rc=${PIPESTATUS[0]}
    set -e
  fi

  if [ "${rc}" -ne 0 ]; then
    # A crash in the report must not replace Gradle's exit code.
    report_test_failures "${marker}" || true
  fi

  rm -f "${marker}" "${outfile}"
  return "${rc}"
}

function finish() {
  # Do any work necessary even if script this fails
  [ -n "${WORK_DIR}" ] && rm -rf "${WORK_DIR}"
  echo "Finished"
}

trap finish EXIT

usage() {
  cat <<'EOF'
Usage: support/scripts/unit-test [module ...] [--tests <filter>]
       support/scripts/unit-test --changed [--base <ref>] [--dry-run]
       support/scripts/unit-test --changed-tests [--base <ref>] [--dry-run]

  (no args)              Run testDebugUnitTest across the whole project.
  <module> [module ...]  Run testDebugUnitTest for one or more modules only.
                          A module may be a short name (e.g. "playback",
                          "core", "app") or a full Gradle path (e.g.
                          ":android:playback"). Short names are resolved by
                          reading settings.gradle(.kts) for the last path
                          segment.
  --tests <filter>        Passed through to Gradle's --tests filter.

  --changed               Map changed files (committed since <ref>, plus
                           uncommitted/untracked) to Gradle modules, compile
                           their unit-test sources first, then run only the
                           affected modules' tests. See "unit-test --changed"
                           in .claude/rules/testing.md for the mapping rules.
    --base <ref>           Diff base. Defaults to origin/main.
    --dry-run               Print the Gradle commands without running them.

  --changed-tests          Like --changed, but maps each changed file to the
                           individual test class(es) that exercise it, for
                           the fastest iteration loop; falls back to a whole
                           module run (or the full suite) the same way
                           --changed does. See "unit-test --changed-tests" in
                           .claude/rules/testing.md. Run the full suite once
                           at the end via --changed or a plain run.
    --base <ref>           Diff base. Defaults to origin/main.
    --dry-run               Print the Gradle commands without running them.

Examples:
  support/scripts/unit-test
  support/scripts/unit-test playback
  support/scripts/unit-test playback app --tests '*NewQueueTest*'
  support/scripts/unit-test --changed
  support/scripts/unit-test --changed --base main --dry-run
  support/scripts/unit-test --changed-tests

Set VERBOSE=1 to print each command as it runs. A leading --remote-build (or
S2_REMOTE_BUILD=1) runs Gradle via remote-build.sh, which picks the Mac or the WSL box.
EOF
}

# Find all Gradle module paths declared via `include '...'` / `include(...)`
# in settings.gradle or settings.gradle.kts.
find_settings_file() {
  if [ -f "${REPO_ROOT}/settings.gradle.kts" ]; then
    echo "${REPO_ROOT}/settings.gradle.kts"
  elif [ -f "${REPO_ROOT}/settings.gradle" ]; then
    echo "${REPO_ROOT}/settings.gradle"
  else
    echo "error: no settings.gradle(.kts) found in ${REPO_ROOT}" >&2
    exit 1
  fi
}

all_module_paths() {
  local settings_file
  settings_file="$(find_settings_file)"
  grep -Eo "include[[:space:]]*\(?[\"']:[^\"']+[\"']" "${settings_file}" \
    | sed -E "s/^include[[:space:]]*\(?[\"']//; s/[\"']$//"
}

# Resolve a module argument (short name or Gradle path) to a Gradle path.
# Prints the resolved path to stdout, or prints candidates to stderr and
# returns 1 if ambiguous/unknown.
resolve_module() {
  local input="$1"
  local all_paths
  all_paths="$(all_module_paths)"

  # Already a full Gradle path.
  if [ "${input#:}" != "${input}" ]; then
    if printf '%s\n' "${all_paths}" | grep -Fxq -- "${input}"; then
      echo "${input}"
      return 0
    else
      echo "error: unknown module path '${input}'" >&2
      return 1
    fi
  fi

  # Short name: prefer an exact ":android:<name>" (top-level module) match,
  # since that's unambiguous by construction; otherwise fall back to
  # matching on the last path segment across all modules.
  local direct_match=":android:${input}"
  if printf '%s\n' "${all_paths}" | grep -Fxq -- "${direct_match}"; then
    echo "${direct_match}"
    return 0
  fi

  local matches
  matches="$(printf '%s\n' "${all_paths}" | awk -F: -v n="${input}" '$NF == n')"

  local count
  count="$(printf '%s\n' "${matches}" | grep -c . || true)"

  if [ "${count}" -eq 1 ]; then
    echo "${matches}"
    return 0
  elif [ "${count}" -gt 1 ]; then
    echo "error: module name '${input}' is ambiguous, candidates:" >&2
    printf '%s\n' "${matches}" | sed 's/^/  /' >&2
    return 1
  else
    echo "error: unknown module '${input}', available modules:" >&2
    printf '%s\n' "${all_paths}" | sed 's/^/  /' >&2
    return 1
  fi
}

##############################################################################
# --changed mode
##############################################################################

# Prints "<module-dir>\t<gradle-path>" for every declared module, e.g.
# "android/mediaprovider/core\t:android:mediaprovider:core".
module_dir_path_pairs() {
  local p dir
  while IFS= read -r p; do
    dir="android$(printf '%s' "${p#:android}" | tr ':' '/')"
    printf '%s\t%s\n' "${dir}" "${p}"
  done < <(all_module_paths)
}

# Resolves a repo-relative file path to the Gradle path of the module whose
# directory it falls under (longest-prefix match), printing
# "<module-dir>\t<gradle-path>", or nothing if it isn't inside any module.
module_dir_and_path_for_file() {
  local file="$1"
  local dir path best_dir="" best_path=""
  while IFS=$'\t' read -r dir path; do
    case "${file}" in
      "${dir}"/*)
        if [ "${#dir}" -gt "${#best_dir}" ]; then
          best_dir="${dir}"
          best_path="${path}"
        fi
        ;;
    esac
  done < <(module_dir_path_pairs)
  [ -n "${best_path}" ] && printf '%s\t%s\n' "${best_dir}" "${best_path}"
}

# A filesystem-safe id for a Gradle path, used as a filename stem under
# WORK_DIR to track per-module state without bash 4 associative arrays.
module_id() {
  printf '%s' "${1#:}" | tr ':' '_'
}

# Echoes the changed files: committed since the merge-base with ${base},
# plus uncommitted (staged/unstaged) and untracked changes. One path per
# line, deduplicated.
changed_files_since() {
  local base="$1" merge_base
  merge_base="$(git -C "${REPO_ROOT}" merge-base "${base}" HEAD 2>/dev/null)" || return 1
  {
    git -C "${REPO_ROOT}" diff --name-only "${merge_base}" HEAD
    git -C "${REPO_ROOT}" diff --name-only HEAD
    git -C "${REPO_ROOT}" ls-files --others --exclude-standard
  } | sort -u
}

print_and_run() {
  echo "+ ${GRADLE_RUNNER[*]} $*"
  if [ "${DRY_RUN}" -eq 1 ]; then
    return 0
  fi
  run_and_report "$@"
}

run_changed_mode() {
  local base="$1"
  local changed_files
  if ! changed_files="$(changed_files_since "${base}")"; then
    echo "error: cannot find a merge base with '${base}' (fetch it first?)" >&2
    exit 2
  fi

  if [ -z "${changed_files}" ]; then
    echo "No changes against ${base}; nothing to run."
    return 0
  fi

  WORK_DIR="$(mktemp -d -t unit-test-changed)"

  # Roborazzi trigger: docs/design/** changed, or any changed file that
  # currently contains a @Composable function.
  local roborazzi=0 f
  while IFS= read -r f; do
    [ -z "${f}" ] && continue
    case "${f}" in
      docs/design/*) roborazzi=1 ;;
    esac
    if [ "${roborazzi}" -eq 0 ] && [ "${f%.kt}" != "${f}" ] && [ -f "${REPO_ROOT}/${f}" ]; then
      grep -q '@Composable' "${REPO_ROOT}/${f}" 2>/dev/null && roborazzi=1
    fi
  done <<< "${changed_files}"

  # Classify each changed android/** file against its module: a src/test
  # file contributes its own class name as a filter candidate (only if it
  # still exists — a deletion contributes nothing); a main file contributes
  # its corresponding *Test class only if exactly one exists, otherwise (and
  # for any non-.kt change, or an androidTest change) the module falls back
  # to a whole run. Any main-source change outside :android:app marks
  # :android:app as downstream-affected, since it depends on nearly every
  # other module. A file under android/** that isn't part of any registered
  # module is skipped with a printed note.
  local mdir mpath id rel cls matches match_count
  while IFS= read -r f; do
    [ -z "${f}" ] && continue
    case "${f}" in
      android/*) ;;
      *) continue ;;
    esac

    IFS=$'\t' read -r mdir mpath <<< "$(module_dir_and_path_for_file "${f}")"
    if [ -z "${mpath}" ]; then
      echo "note: '${f}' is under android/ but isn't part of a registered module; skipping"
      continue
    fi
    id="$(module_id "${mpath}")"
    echo "${mpath}" >> "${WORK_DIR}/modules_seen"
    rel="${f#"${mdir}"/}"

    case "${rel}" in
      src/test/*.kt)
        # Only filter on classes that still exist; a deleted test file must
        # not add a --tests filter for a class Gradle can no longer find.
        if [ -f "${REPO_ROOT}/${f}" ]; then
          cls="$(basename "${rel}" .kt)"
          echo "${cls}" >> "${WORK_DIR}/${id}.classes"
        fi
        ;;
      src/androidTest/*.kt)
        # androidTest classes aren't part of testDebugUnitTest; filtering on
        # one fails with "No tests found", so fall back to a whole run.
        echo "note: '${f}' is an androidTest source; running ${mpath} whole"
        touch "${WORK_DIR}/${id}.unmappable"
        ;;
      src/main/*.kt)
        cls="$(basename "${rel}" .kt)"
        matches="$(find "${REPO_ROOT}/${mdir}/src/test" "${REPO_ROOT}/${mdir}/src/androidTest" \
          -type f -name "${cls}Test.kt" 2>/dev/null || true)"
        match_count="$(printf '%s\n' "${matches}" | grep -c . || true)"
        if [ "${match_count}" -eq 1 ]; then
          echo "${cls}Test" >> "${WORK_DIR}/${id}.classes"
        else
          touch "${WORK_DIR}/${id}.unmappable"
        fi
        touch "${WORK_DIR}/${id}.main"
        [ "${mpath}" != ":android:app" ] && touch "${WORK_DIR}/app_downstream_triggered"
        ;;
      src/test/*|src/androidTest/*)
        # Non-.kt test-source change (e.g. resources): run the module whole.
        touch "${WORK_DIR}/${id}.unmappable"
        ;;
      *)
        # Non-.kt, non-test change (build.gradle.kts, manifest, resources):
        # run the module whole, and treat it like a main-source change.
        touch "${WORK_DIR}/${id}.unmappable"
        touch "${WORK_DIR}/${id}.main"
        [ "${mpath}" != ":android:app" ] && touch "${WORK_DIR}/app_downstream_triggered"
        ;;
    esac
  done <<< "${changed_files}"

  # Build-system-wide changes (buildSrc, the Gradle wrapper/version catalog,
  # root build/settings files) can affect any module's classpath or task
  # graph; per-module mapping doesn't apply, so fall back to the full suite.
  local full_suite_trigger
  full_suite_trigger="$(printf '%s\n' "${changed_files}" | grep -E \
    '^buildSrc/|^gradle/|^build\.gradle(\.kts)?$|^settings\.gradle(\.kts)?$|^gradle\.properties$' \
    | head -1 || true)"

  if [ -n "${full_suite_trigger}" ]; then
    echo "Build-system file changed ('${full_suite_trigger}'); running the full test suite."
    # One invocation: a module's verifyRoborazziDebug in the task graph switches that module's
    # testDebugUnitTest to verify mode, so its suite runs once rather than twice (#552).
    local full_tasks=(testDebugUnitTest)
    if [ "${roborazzi}" -eq 1 ]; then
      full_tasks+=(":android:app:verifyRoborazziDebug" ":android:designsystem:verifyRoborazziDebug")
    fi
    local full_rc=0
    print_and_run "${full_tasks[@]}" || full_rc=$?
    return "${full_rc}"
  fi

  if [ ! -f "${WORK_DIR}/modules_seen" ] && [ "${roborazzi}" -eq 0 ]; then
    echo "No modules affected; nothing to run."
    return 0
  fi

  local app_path=":android:app"
  local app_downstream=0
  [ -f "${WORK_DIR}/app_downstream_triggered" ] && app_downstream=1

  local modules=()
  if [ -f "${WORK_DIR}/modules_seen" ]; then
    while IFS= read -r mpath; do
      modules+=("${mpath}")
    done < <(sort -u "${WORK_DIR}/modules_seen")
  fi

  local app_in_modules=0 m
  for m in "${modules[@]:-}"; do
    [ "${m}" = "${app_path}" ] && app_in_modules=1
  done

  # :android:app runs a normal (filtered-or-whole) invocation if it changed
  # directly or was pulled in downstream; roborazzi alone only adds the
  # verifyRoborazziDebug task, not the whole app suite.
  local app_test_needed=0
  [ "${app_in_modules}" -eq 1 ] || [ "${app_downstream}" -eq 1 ] && app_test_needed=1
  if [ "${app_test_needed}" -eq 1 ] && [ "${app_in_modules}" -eq 0 ]; then
    modules+=("${app_path}")
  fi

  local compile_modules=()
  if [ "${#modules[@]}" -gt 0 ]; then compile_modules=("${modules[@]}"); fi
  if [ "${roborazzi}" -eq 1 ] && [ "${app_test_needed}" -eq 0 ]; then
    compile_modules+=("${app_path}")
  fi

  echo "Base: ${base}"
  echo "Changed files: $(printf '%s\n' "${changed_files}" | grep -c .)"
  echo "Affected modules: ${modules[*]:-(none)}"
  [ "${roborazzi}" -eq 1 ] && echo "Roborazzi: verifyRoborazziDebug will run (docs/design or @Composable change)"
  echo

  # 1. Compile unit-test sources for every affected module first; stop here
  #    on a compile error so it doesn't surface mid test-run.
  if [ "${#compile_modules[@]}" -gt 0 ]; then
    local compile_tasks=() cm
    for cm in "${compile_modules[@]}"; do
      compile_tasks+=("${cm}:compileDebugUnitTestKotlin")
    done
    if ! print_and_run "${compile_tasks[@]}"; then
      echo "Compile failed; stopping before running tests." >&2
      return 1
    fi
  fi

  # 2. Run tests: batch every whole-module run into one invocation (safe,
  #    since none of them pass --tests), and run each filtered module in
  #    its own invocation so its --tests filter can't shadow another
  #    module's tests in the same build.
  local overall_rc=0 whole_batch=() mid unmappable_file classes_file
  for m in "${modules[@]:-}"; do
    [ -z "${m}" ] && continue
    mid="$(module_id "${m}")"
    unmappable_file="${WORK_DIR}/${mid}.unmappable"
    classes_file="${WORK_DIR}/${mid}.classes"

    local whole=0
    if [ "${m}" = "${app_path}" ] && [ "${app_downstream}" -eq 1 ]; then
      whole=1
    elif [ -f "${unmappable_file}" ] || [ ! -s "${classes_file}" ]; then
      whole=1
    fi

    if [ "${whole}" -eq 1 ]; then
      whole_batch+=("${m}:testDebugUnitTest")
      if [ "${m}" = "${app_path}" ] && [ "${roborazzi}" -eq 1 ]; then
        whole_batch+=("${app_path}:verifyRoborazziDebug")
        roborazzi=2 # placed; 2 means "handled" so the solo run below is skipped
      fi
    else
      local filter_args=() cls_line
      while IFS= read -r cls_line; do
        [ -z "${cls_line}" ] && continue
        filter_args+=(--tests "${cls_line}")
      done < <(sort -u "${classes_file}")
      local run_tasks=("${m}:testDebugUnitTest")
      if [ "${m}" = "${app_path}" ] && [ "${roborazzi}" -eq 1 ]; then
        run_tasks+=("${app_path}:verifyRoborazziDebug")
        roborazzi=2
      fi
      print_and_run "${run_tasks[@]}" "${filter_args[@]}" || overall_rc=$?
    fi
  done

  if [ "${#whole_batch[@]}" -gt 0 ]; then
    print_and_run "${whole_batch[@]}" || overall_rc=$?
  fi

  # roborazzi still 1 here means :android:app wasn't otherwise scheduled
  # (e.g. a docs/design-only change): run just the verify task.
  if [ "${roborazzi}" -eq 1 ]; then
    print_and_run "${app_path}:verifyRoborazziDebug" || overall_rc=$?
  fi

  return "${overall_rc}"
}

##############################################################################
# --changed-tests mode
##############################################################################

# Maps one changed src/main/*.kt file to the test class names in its module
# that exercise it, one per line (nothing if none map): itself, if a
# "<class>Test.kt" file exists anywhere under the module's src/test, plus any
# "*Test.kt" that references the class by name (plain substring grep over the
# test sources, kept simple and predictable per #552). A ViewModel also
# matches on its name with the "ViewModel" suffix stripped, to catch a
# screen's Robot-based test that exercises it without naming the ViewModel
# class directly (e.g. LibraryScreenTest for SongListViewModel, since SongList
# is part of the Library screen rather than its own).
classes_for_main_file() {
  local abs_file="$1" test_dir="$2" cls stem hit
  cls="$(basename "${abs_file}" .kt)"
  [ -d "${test_dir}" ] || return 0

  if find "${test_dir}" -type f -name "${cls}Test.kt" 2>/dev/null | grep -q .; then
    echo "${cls}Test"
  fi

  while IFS= read -r hit; do
    [ -z "${hit}" ] && continue
    basename "${hit}" .kt
  done < <(grep -rl --include='*Test.kt' -F -- "${cls}" "${test_dir}" 2>/dev/null || true)

  stem="${cls%ViewModel}"
  if [ "${stem}" != "${cls}" ] && [ -n "${stem}" ]; then
    while IFS= read -r hit; do
      [ -z "${hit}" ] && continue
      basename "${hit}" .kt
    done < <(grep -rl --include='*Test.kt' -F -- "${stem}" "${test_dir}" 2>/dev/null || true)
  fi
}

run_changed_tests_mode() {
  local base="$1"
  local changed_files
  if ! changed_files="$(changed_files_since "${base}")"; then
    echo "error: cannot find a merge base with '${base}' (fetch it first?)" >&2
    exit 2
  fi

  if [ -z "${changed_files}" ]; then
    echo "No changes against ${base}; nothing to run."
    return 0
  fi

  # Build-system-wide changes affect any module's classpath or task graph;
  # class-level mapping doesn't apply, so fall back to the whole --changed run.
  local full_suite_trigger
  full_suite_trigger="$(printf '%s\n' "${changed_files}" | grep -E \
    '^buildSrc/|^gradle/|^build\.gradle(\.kts)?$|^settings\.gradle(\.kts)?$|^gradle\.properties$' \
    | head -1 || true)"
  if [ -n "${full_suite_trigger}" ]; then
    echo "Build-system file changed ('${full_suite_trigger}'); falling back to 'unit-test --changed'."
    run_changed_mode "${base}"
    return $?
  fi

  WORK_DIR="$(mktemp -d -t unit-test-changed-tests)"

  local mdir mpath id rel test_dir f cls
  while IFS= read -r f; do
    [ -z "${f}" ] && continue
    case "${f}" in
      android/*) ;;
      *) continue ;;
    esac

    IFS=$'\t' read -r mdir mpath <<< "$(module_dir_and_path_for_file "${f}")"
    if [ -z "${mpath}" ]; then
      echo "note: '${f}' is under android/ but isn't part of a registered module; skipping"
      continue
    fi
    id="$(module_id "${mpath}")"
    echo "${mpath}" >> "${WORK_DIR}/modules_seen"
    rel="${f#"${mdir}"/}"
    test_dir="${REPO_ROOT}/${mdir}/src/test"

    case "${rel}" in
      src/test/*.kt)
        # A screenshot test belongs to the final verify (Roborazzi runs in
        # verify mode there), not a --tests run here; treat it like any
        # other change that maps to no runnable class.
        cls="$(basename "${rel}" .kt)"
        if [ -f "${REPO_ROOT}/${f}" ] && [ "${cls%ScreenshotTest}" = "${cls}" ]; then
          echo "${cls}" >> "${WORK_DIR}/${id}.classes"
        elif [ -f "${REPO_ROOT}/${f}" ]; then
          echo "note: '${f}' is a screenshot test; falling back to a whole run of ${mpath}"
          touch "${WORK_DIR}/${id}.unmappable"
        fi
        ;;
      src/androidTest/*.kt)
        echo "note: '${f}' is an androidTest source; falling back to a whole run of ${mpath}"
        touch "${WORK_DIR}/${id}.unmappable"
        ;;
      src/main/*.kt)
        local found=0 name
        while IFS= read -r name; do
          [ -z "${name}" ] && continue
          [ "${name%ScreenshotTest}" != "${name}" ] && continue
          echo "${name}" >> "${WORK_DIR}/${id}.classes"
          found=1
        done < <(classes_for_main_file "${REPO_ROOT}/${f}" "${test_dir}")
        if [ "${found}" -eq 0 ]; then
          echo "note: '${f}' maps to no test class; falling back to a whole run of ${mpath}"
          touch "${WORK_DIR}/${id}.unmappable"
        fi
        ;;
      *)
        echo "note: '${f}' is a non-Kotlin change; falling back to a whole run of ${mpath}"
        touch "${WORK_DIR}/${id}.unmappable"
        ;;
    esac
  done <<< "${changed_files}"

  if [ ! -f "${WORK_DIR}/modules_seen" ]; then
    echo "No modules affected; nothing to run."
    return 0
  fi

  echo "Base: ${base}"
  echo "Changed files: $(printf '%s\n' "${changed_files}" | grep -c .)"
  echo

  local overall_rc=0 whole_batch=() m mid unmappable_file classes_file classes_sorted count preview
  while IFS= read -r m; do
    mid="$(module_id "${m}")"
    unmappable_file="${WORK_DIR}/${mid}.unmappable"
    classes_file="${WORK_DIR}/${mid}.classes"

    if [ -f "${unmappable_file}" ] || [ ! -s "${classes_file}" ]; then
      echo "${m}: running whole (no class-level mapping)"
      whole_batch+=("${m}:testDebugUnitTest")
      continue
    fi

    classes_sorted="$(sort -u "${classes_file}")"
    count="$(printf '%s\n' "${classes_sorted}" | grep -c .)"
    preview="$(printf '%s\n' "${classes_sorted}" | head -5 | paste -sd, -)"
    if [ "${count}" -gt 5 ]; then
      preview="${preview}, ..."
    fi
    echo "${m}: ${count} class(es): ${preview}"

    local filter_args=() cls_line
    while IFS= read -r cls_line; do
      [ -z "${cls_line}" ] && continue
      filter_args+=(--tests "${cls_line}")
    done <<< "${classes_sorted}"
    print_and_run "${m}:testDebugUnitTest" "${filter_args[@]}" || overall_rc=$?
  done < <(sort -u "${WORK_DIR}/modules_seen")

  if [ "${#whole_batch[@]}" -gt 0 ]; then
    print_and_run "${whole_batch[@]}" || overall_rc=$?
  fi

  return "${overall_rc}"
}

if [ "$#" -gt 0 ] && [ "$1" = "--changed" ]; then
  shift
  DRY_RUN=0
  BASE_REF="origin/main"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        shift
        [ "$#" -gt 0 ] || { echo "error: --base requires an argument" >&2; exit 2; }
        BASE_REF="$1"
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "error: unexpected argument '$1' after --changed" >&2
        exit 2
        ;;
    esac
  done
  run_changed_mode "${BASE_REF}"
  exit $?
fi

if [ "$#" -gt 0 ] && [ "$1" = "--changed-tests" ]; then
  shift
  DRY_RUN=0
  BASE_REF="origin/main"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        shift
        [ "$#" -gt 0 ] || { echo "error: --base requires an argument" >&2; exit 2; }
        BASE_REF="$1"
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "error: unexpected argument '$1' after --changed-tests" >&2
        exit 2
        ;;
    esac
  done
  run_changed_tests_mode "${BASE_REF}"
  exit $?
fi

if [ "$#" -eq 0 ]; then
  run_and_report testDebugUnitTest
  exit $?
fi

modules=()
tests_filter=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --tests)
      shift
      if [ "$#" -eq 0 ]; then
        echo "error: --tests requires an argument" >&2
        exit 2
      fi
      tests_filter="$1"
      shift
      ;;
    *)
      modules+=("$1")
      shift
      ;;
  esac
done

if [ "${#modules[@]}" -eq 0 ]; then
  whole_project_args=(testDebugUnitTest)
  if [ -n "${tests_filter}" ]; then
    whole_project_args+=(--tests "${tests_filter}")
  fi
  run_and_report "${whole_project_args[@]}"
  exit $?
fi

tasks=()
for module in "${modules[@]}"; do
  resolved="$(resolve_module "${module}")" || exit 2
  tasks+=("${resolved}:testDebugUnitTest")
done

gradle_args=("${tasks[@]}")
if [ -n "${tests_filter}" ]; then
  gradle_args+=(--tests "${tests_filter}")
fi

run_and_report "${gradle_args[@]}"
exit $?
