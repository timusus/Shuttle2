#!/usr/bin/env bash
# ktlint over the Kotlin files this branch changed.
#
#   lint [-F] [files...]      explicit files, else the .kt/.kts files changed against the merge-base
#                             with origin/main plus staged, unstaged and untracked ones
#   lint --base <rev> ...     committed changes <rev>..HEAD only (for linting a batch as picked)
#   lint --all [-F]           the whole tree
#
# -F formats in place. Deleted files and generated/ or build/ paths are skipped.
set -uo pipefail

SUPPORT_DIR="${BASH_SOURCE[0]%/*}/.."
VENDOR_DIR="${SUPPORT_DIR}/vendor"
PATH="${VENDOR_DIR}/ktlint:$PATH"

all=0
base=""
args=()
files=()
while [ $# -gt 0 ]; do
  case "$1" in
    --all) all=1 ;;
    --base) base="${2:?--base needs a revision}"; shift ;;
    --base=*) base="${1#--base=}" ;;
    -r|--reporter|--editorconfig|--baseline|--code-style|--log-level) args+=("$1" "${2:?$1 needs a value}"); shift ;;
    -*) args+=("$1") ;;
    *) files+=("$1") ;;
  esac
  shift
done

if [ "$all" = 1 ]; then
  exec ktlint ${args[@]+"${args[@]}"} "**.kt" "**.kts" "!**/generated/**" "!**/build/**"
fi

if [ ${#files[@]} -eq 0 ]; then
  root="$(git rev-parse --show-toplevel)" || exit 1
  cd "$root" || exit 1
  if [ -n "$base" ]; then
    # Committed changes only: lint the batch as picked, not the working tree.
    changed() { git -c core.quotePath=false diff --name-only --diff-filter=d "$base" HEAD --; }
  else
    base="$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)"
    changed() {
      git -c core.quotePath=false diff --name-only --diff-filter=d "$base" --
      git -c core.quotePath=false ls-files --others --exclude-standard
    }
  fi
  list="$(
    changed | grep -E '\.kts?$' | grep -Ev '(^|/)(generated|build)/' | sort -u
  )"
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && files+=("$f")
  done <<<"$list"
fi

if [ ${#files[@]} -eq 0 ]; then
  echo "lint: no changed Kotlin files"
  exit 0
fi

# Kotlin/Native-illegal backtick test names (#908): a grep, so cheap enough to run alongside ktlint.
"${BASH_SOURCE[0]%/*}/native-test-names" "${files[@]}" || exit 1

exec ktlint ${args[@]+"${args[@]}"} "${files[@]}"
