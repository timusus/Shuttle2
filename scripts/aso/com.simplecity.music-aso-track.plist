<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.simplecity.music-aso-track</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ASO_DIR__/aso</string>
    <string>track</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__TOOL_PATH__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>43</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/share/shuttle-music-aso/track.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/share/shuttle-music-aso/track.log</string>
</dict>
</plist>
