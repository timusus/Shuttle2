# Shared configuration for the Shuttle2 k8s one-shot builders.
# Sourced by every script in k8s/scripts/. Override per call, e.g.:
#   NAMESPACE=shuttle-build ./build-remote.sh --task :android:app:assembleDebug

# --- cluster ---------------------------------------------------------------
# kubeconfig context. OffBookPlus scripts default to colima; this cluster is
# a standalone k3s, so the default here is the current context (empty = kubectl default).
KUBE_CONTEXT="${KUBE_CONTEXT:-}"
NAMESPACE="${NAMESPACE:-shuttle-build}"
KUBECTL="${KUBECTL:-kubectl}"

# --- images ----------------------------------------------------------------
# Prebuilt toolchain (k8s/Dockerfile). Only needed for build.sh (docker flow).
IMAGE="${IMAGE:-localhost/shuttle-android-builder:jdk21}"
# Base image for build-remote.sh (SDK bootstrapped at runtime, no image build).
REMOTE_BASE_IMAGE="${REMOTE_BASE_IMAGE:-eclipse-temurin:21-jdk-noble}"
SEED_IMAGE="${SEED_IMAGE:-alpine:3.21}"

# --- persistent cache ------------------------------------------------------
# One RWO PVC (local-path) holds sdk/, gradle/ and workspace/ across builds.
CACHE_PVC="${CACHE_PVC:-shuttle-build-cache}"
CACHE_SIZE="${CACHE_SIZE:-25Gi}"

# --- build job -------------------------------------------------------------
GRADLE_TASK="${GRADLE_TASK:-:android:app:assembleDebug}"
JOB_CPU_LIMIT="${JOB_CPU_LIMIT:-3}"
JOB_MEM_LIMIT="${JOB_MEM_LIMIT:-6000Mi}"
GRADLE_OPTS_VALUE="${GRADLE_OPTS_VALUE:--Dorg.gradle.jvmargs=-Xmx4g -Dkotlin.compiler.execution.strategy=in-process -Dorg.gradle.workers.max=2}"
JOB_DEADLINE_SECONDS="${JOB_DEADLINE_SECONDS:-3000}"

# --- app -------------------------------------------------------------------
APP_ID="${APP_ID:-com.simplecityapps.shuttle}"
