<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The name of the Shuttle Music scanner - the media provider which scans the device for songs and reads their tags (metadata)-->
    <string name="media_provider_title_s2">Shuttle Music Medya Sağlayıcısı</string>
    <!-- The description of the Shuttle Music scanner - scans user selected folders and files for metadata-->
    <string name="media_provider_description_s2">Gelişmiş kullanıcılar için. Özel bir etiket okuyucu kullanır ve etiket düzenleme ve tekrar oynatma dahil olmak üzere ek özelliklere izin verir</string>
    <!-- The name of the 'Android Media Store' media provider. The 'Media Store' is an Android concept. Not sure if it would be translated.-->
    <string name="media_provider_title_media_store">Android Medya Store</string>
    <!-- The description of the Android MediaStore media provider. The MediaStore is an Android concept. A database on the device which keeps track of song info-->
    <string name="media_provider_description_media_store">Android Medya Store veritabanındaki dosyalara basit ve hızlı erişim</string>
    <!-- The name of the 'Emby' media provider. Emby is a personal media server - probably doesn't need to be translated-->
    <string name="media_provider_title_emby">Emby</string>
    <!-- The description of the 'Emby' media provider. Emby is a personal media server - probably doesn't need to be translated-->
    <string name="media_provider_description_emby">Kişisel medya sunucusu</string>
    <!-- The name of the 'Jellyfin' media provider. Jellyfin is a personal media server - probably doesn't need to be translated-->
    <string name="media_provider_title_jellyfin">Jellyfin</string>
    <!-- The description of the 'Jellyfin' media provider. Jellyfin is a personal media server - probably doesn't need to be translated-->
    <string name="media_provider_description_jellyfin">Kişisel medya sunucusu</string>
    <!-- The name of the 'Plex' media provider. Plex is a personal media server - probably doesn't need to be translated-->
    <string name="media_provider_title_plex">Plex</string>
    <!-- The description of the 'Plex' media provider. Plex is a personal media server - probably doesn't need to be translated-->
    <string name="media_provider_description_plex">Kişisel medya sunucusu</string>
    <!-- Shown when a media provider scan has failed -->
    <string name="media_provider_scan_failure_title">Tarama başarısız</string>
    <!-- Dialog button shown to authenticate with Jellyfin/Emby/Plex (submits the user's credentials for authentication)-->
    <string name="media_provider_button_authenticate">Kimlik doğrula</string>
    <!-- Shown when Jellyfin/Emby/Plex is authenticating the user's credentials-->
    <string name="media_provider_authenticating">Kimlik doğrulanıyor...</string>
    <!-- Shown when Jellyfin/Emby/Plex has successfully authenticated the user's credentials-->
    <string name="media_provider_authentication_success">Kimlik Doğrulama Başarılı</string>
    <!-- The longer title of Plex Media Server. 'Plex' probably doesn't need translation -->
    <string name="media_provider_title_long_plex">Plex Medya Sunucusu</string>
    <!-- The longer title of Jellyfin Media Server. 'Jellyfin' probably doesn't need translation -->
    <string name="media_provider_title_long_jellyfin">Jellyfin Medya Sunucusu</string>
    <!-- The longer title of Emby Media Server. 'Emby' probably doesn't need translation -->
    <string name="media_provider_title_long_emby">Emby Medya Sunucusu</string>
    <!-- Shown when user is selecting which media provider to use. Groups media providers into local (device based) and remote (network based) media providers. -->
    <string name="media_provider_type_local">Yerel</string>
    <!-- Shown when user is selecting which media provider to use. Groups media providers into local (device based) and remote (network based) media providers. -->
    <string name="media_provider_type_remote">Uzaktan</string>
    <!-- Button to add a media provider. A media provider is a source of media, e.g. Android Media Store, Shuttle Music scanner, Jellyfin Media Server, etc. -->
    <string name="media_provider_add">Medya sağlayıcı ekle</string>
    <!-- Button to add a media provider, shown during onboarding. A media provider is a source of media, e.g. Android Media Store, Shuttle Music scanner, Jellyfin Media Server, etc. -->
    <string name="media_providers_add_onboarding">Medya sağlayıcısı ekleyin. Sonra değiştirebilirsiniz.</string>
    <!-- Shown during onboarding, as the user is about to select their media providers, to discover/find their music-->
    <string name="media_provider_toolbar_title_onboarding">Müziğini keşfet</string>
    <!-- Title of the screen where users can select their media providers. A media provider is a source of media, e.g. Android Media Store, Shuttle Music scanner, Jellyfin Media Server, etc. -->
    <string name="media_provider_toolbar_title">Medya sağlayıcılar</string>
    <!-- Button to remove a media provider from the list of media providers to be scanned. A media provider is a source of media, e.g. Android Media Store, Shuttle Music scanner, Jellyfin Media Server, etc. -->
    <string name="media_provider_dialog_button_remove">Kaldır</string>
    <!-- The address (url) of the user's Emby/Jellyfin/Plex media provider. -->
    <string name="media_provider_config_hint_address">Adres</string>
    <!-- The username of the user's Emby/Jellyfin/Plex media provider. -->
    <string name="media_provider_config_hint_username">Kullanıcı adı</string>
    <!-- The password for the user's Emby/Jellyfin/Plex media provider. -->
    <string name="media_provider_config_hint_password">Parola</string>
    <!-- The option to remember the user's password for their Emby/Jellyfin/Plex media provider-->
    <string name="media_provider_config_switch_remember_password">Parolayı hatırla</string>
    <!-- Favorites playlist name - user's favorite songs -->
    <string name="playlist_title_favorites">Favoriler</string>
    <!-- 'Most Played' playlist name - playlist of songs with highest play count -->
    <string name="playlist_title_most_played">En çok çalınan</string>
    <!-- 'Recently Added' playlist name - playlist of songs which have been recently added -->
    <string name="playlist_title_recently_added">Son eklenenler</string>
    <!-- 'History' playlist name - playlist of songs which have been recently played -->
    <string name="playlist_title_history">Geçmiş</string>
    <!-- Error message shown when a remote media provider (jellyfin/emby/plex) fails to authenticate -->
    <string name="media_provider_authentication_error">Kimlik doğrulanamadı</string>
    <!-- Error message shown when the server address is missing for a remote media provider (jellyfin/emby/plex) -->
    <string name="media_provider_address_missing">Sunucu adresi eksik</string>
    <!-- Import progress: signing in to a media server; the argument is its kind (Jellyfin, Emby or Plex) -->
    <string name="media_import_connecting">%1$s ile bağlantı kuruluyor…</string>
    <!-- Import progress: asking the library for its songs, before it has said how many there are -->
    <string name="media_import_fetching">Kitaplığınız alınıyor…</string>
    <!-- Import progress: asking the library for its songs, with how many so far of how many (numbers already formatted) -->
    <string name="media_import_fetching_songs">%2$s şarkıdan %1$s şarkı alınıyor</string>
    <!-- Import progress: writing the songs found to the library (number already formatted) -->
    <plurals name="media_import_saving_songs">
        <item quantity="one">%1$s şarkı kaydediliyor…</item>
        <item quantity="other">%1$s şarkı kaydediliyor…</item>
    </plurals>
    <!-- Shown when the media importer fails to import songs -->
    <string name="media_import_error">Şarkılar içe aktarılırken bir hata oluştu</string>
    <!-- Shown when the Shuttle Music scanner fails to find any folders to scan -->
    <string name="media_import_directories_empty">Taranacak klasör/dosya yok</string>
    <!-- Shown when the Shuttle Music scanner is searching an m3u playlist for songs -->
    <string name="media_import_m3u_scan"><xliff:g example="playlist1.m3u" id="playlist_name">%1$s</xliff:g> için şarkı bulunuyor.</string>
</resources>
