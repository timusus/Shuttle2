<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Definições</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Limpar arte</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Limpar</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Isto vai remover permanentemente todas as artes em cache</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Transferir todas as artes</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Isto vai transferir todas as artes, independentemente da sua ligação à rede (WiFi/dados/outras)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Transferir</string>
    <!-- Settings option to copy debug logs to clipboard -->
    <string name="settings_logging_clipboard_name">Registos de depuração</string>
    <!-- Shown when the debug logs have been copied to the clipboard -->
    <string name="settings_logging_clipboard_logs_copied">Logs copiados para a área de transferência</string>
    <!-- Error message shown when copying debug logs failed, because the log file is too large -->
    <string name="settings_logging_clipboard_logs_too_large">O ficheiro de log é muito grande para a área de transferência</string>
    <!-- Error message shown when copying debug logs failed, because there are no logs -->
    <string name="settings_logging_clipboard_logs_empty">Ficheiro de log vazio</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Ecrã</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Arte</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgets</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Privacidade</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Tema</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Realce</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Reverificar</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Verifique novamente os fornecedores de mídia selecionados</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Cópia de segurança</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Criar cópia de segurança da biblioteca</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Guardar contagens de reprodução, favoritos, exclusões, playlists e as suas definições num ficheiro</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Restaurar cópia de segurança da biblioteca</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Intercala uma cópia de segurança na sua biblioteca e substitui as suas definições pelas que ela contém</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Cópia de segurança da biblioteca guardada</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Falha ao criar a cópia de segurança da biblioteca</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Não foi possível ler esse ficheiro de cópia de segurança</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Restauro concluído: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Restauro concluído: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Nada nesta cópia de segurança correspondeu à sua biblioteca</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Definições restauradas; nenhuma música ou playlist desta cópia de segurança correspondeu à sua biblioteca</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; definições restauradas</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d música correspondente</item>
        <item quantity="other">%1$d músicas correspondentes</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d playlist adicionada ou atualizada</item>
        <item quantity="other">%1$d playlists adicionadas ou atualizadas</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d música não encontrada</item>
        <item quantity="other">%1$d músicas não encontradas</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Excluído</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Ver/Editar excluído</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Só Wi-Fi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Transferir arte de fontes remotas apenas quando o Wi-Fi estiver disponível</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Só local</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Não transferir arte de fontes remotas (Internet)</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Limpar arte</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Remove todas as artes em cache</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Transferir todas as artes</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Opacidade do fundo</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Ver changelog</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Relatórios de crash</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Ver licenças</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Registo de depuração</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Grava os registos num ficheiro no disco</string>
    <!-- Settings: Title for the option to copy the debug logs to the clipboard -->
    <string name="pref_copy_debug_logs_subtitle">Copiar logs de debug</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Arte da sessão multimédia</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Forneça a arte para a sessão multimédia do Android. Desative para impedir a arte no ecrã de bloqueio</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">Quando uma nova fila é selecionada o modo aleatório não será desactivado</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Dia/Noite</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Claro</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Escuro</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Azul Shuttle</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Ciano</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Roxo</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Verde</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Laranja</string>
</resources>
