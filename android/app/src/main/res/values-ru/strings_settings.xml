<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Настройки</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Очистить обложку</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Очистить</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Это приведет к безвозвратному удалению всех кешированных обложек</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Скачать все обложки</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Это загрузит все обложки, независимо от вашего сетевого подключения (Wi-Fi/данные/другое)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Скачать</string>
    <!-- Settings option to copy debug logs to clipboard -->
    <string name="settings_logging_clipboard_name">Отчет об ошибках</string>
    <!-- Shown when the debug logs have been copied to the clipboard -->
    <string name="settings_logging_clipboard_logs_copied">Журналы скопированы в буфер обмена</string>
    <!-- Error message shown when copying debug logs failed, because the log file is too large -->
    <string name="settings_logging_clipboard_logs_too_large">Файл журнала слишком велик для буфера обмена</string>
    <!-- Error message shown when copying debug logs failed, because there are no logs -->
    <string name="settings_logging_clipboard_logs_empty">Файл журнала пуст</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Отображение</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Обложка</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Виджеты</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Конфиденциальность</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Тема</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Акцент</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Повторное сканирование</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Повторно просканируйте выбранных медиа-провайдеров</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Резервная копия</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Создать резервную копию библиотеки</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Сохранить счётчики прослушиваний, избранное, исключённые композиции, плейлисты и настройки в файл</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Восстановить резервную копию библиотеки</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Объединить резервную копию с библиотекой и заменить настройки теми, что в ней</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Резервная копия библиотеки сохранена</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Не удалось создать резервную копию библиотеки</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Не удалось прочитать файл резервной копии</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Восстановление завершено: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Восстановление завершено: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">В этой резервной копии нет ничего, что совпало бы с вашей библиотекой</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Настройки восстановлены; в этой копии нет песен или плейлистов, совпавших с вашей библиотекой</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; настройки восстановлены</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">Совпала %1$d композиция</item>
        <item quantity="few">Совпало %1$d композиции</item>
        <item quantity="many">Совпало %1$d композиций</item>
        <item quantity="other">Совпало %1$d композиций</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">Добавлен или обновлён %1$d плейлист</item>
        <item quantity="few">Добавлено или обновлено %1$d плейлиста</item>
        <item quantity="many">Добавлено или обновлено %1$d плейлистов</item>
        <item quantity="other">Добавлено или обновлено %1$d плейлистов</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">Не найдена %1$d композиция</item>
        <item quantity="few">Не найдено %1$d композиции</item>
        <item quantity="many">Не найдено %1$d композиций</item>
        <item quantity="other">Не найдено %1$d композиций</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Исключено</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Просмотр/редактирование исключено</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Только Wi-Fi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Загрузка обложек из удаленных источников только при наличии Wi-Fi</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Только локальные</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Не загружать обложки из удаленных (интернет-) источников</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Очистить обложки</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Удаляет все кешированные обложки</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Скачать все обложки</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Прозрачность фона</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Посмотреть журнал изменений</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Отчеты о сбоях</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Просмотреть лицензии</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Журнал отладки</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Записывает логи в файл на диске</string>
    <!-- Settings: Title for the option to copy the debug logs to the clipboard -->
    <string name="pref_copy_debug_logs_subtitle">Копировать журналы отладки</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Работа с медиа-сессией</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Поставлять обложки для Media Session на Android. Отключить, чтобы предотвратить блокировку экрана.</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">День/ночь</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Светлая</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Темная</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Синий Shuttle</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Голубой</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Фиолетовый</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Зеленый</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Оранжевый</string>
</resources>
