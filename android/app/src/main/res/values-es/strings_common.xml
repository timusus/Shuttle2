<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Shown when text is required in a text field -->
    <string name="validation_field_required">Obligatorio</string>
    <!-- Shown when an unexpected error occurs -->
    <string name="error_unexpected">Se produjo un error inesperado</string>
    <!-- Shown when an unknown error occurs -->
    <string name="error_unknown">Se produjo un error desconocido</string>
    <!-- Shown when songs are added to the queue -->
    <plurals name="queue_songs_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> canción añadida a la cola</item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g> canciones añadidas a la cola</item>
    </plurals>
    <!-- Shown when current playback queue is added to a playlist -->
    <string name="playlist_queue_added">Cola añadida a <xliff:g example="Favourites" id="playlist_name">%1$s</xliff:g></string>
    <!-- Shown when songs are added to a playlist -->
    <plurals name="playlist_songs_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> canción añadida a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g> canciones añadidas a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when albums are added to a playlist -->
    <plurals name="playlist_albums_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> álbum añadido a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g> álbumes añadidos a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when artists are added to a playlist -->
    <plurals name="playlist_artists_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> artista añadido a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g> artistas añadidos a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when genres are added to a playlist -->
    <plurals name="playlist_genres_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> género añadido a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g> géneros añadidos a <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- The disc number for this album-->
    <string name="disc_number">Disco <xliff:g example="1" id="disc_number">%1$d</xliff:g></string>
    <!-- Shown when the songs list finishes loading, and there are no songs-->
    <string name="song_list_empty">Sin canciones</string>
    <!-- Shown when the albums list finishes loading, and there are no songs-->
    <string name="album_list_empty">Sin álbumes</string>
    <!-- Shown when the artists list finishes loading, and there are no songs-->
    <string name="artist_list_empty">Sin artistas</string>
    <!-- Shown when the genres list finishes loading, and there are no songs-->
    <string name="genre_list_empty">Sin géneros</string>
    <!-- Shown when the playlists list finishes loading, and there are no songs-->
    <string name="playlist_list_empty">Sin listas de reproducción</string>
    <!-- Button to skip to the next track -->
    <string name="button_skip_next">Saltar siguiente</string>
    <!-- Button to play/pause the current song-->
    <string name="button_toggle_playback">Alternar reproducción</string>
    <!-- Button to skip to the previous track-->
    <string name="button_skip_previous">Saltar anterior</string>
    <!-- Shown when the playback queue is empty -->
    <string name="queue_empty">Cola vacía</string>
</resources>
