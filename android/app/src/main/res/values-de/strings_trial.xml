<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The title of the menu button. When clicked, will show the 'free trial' dialog, with an option for the user to upgrade-->
    <string name="menu_trial">Probezeit</string>
    <!-- The heading of the 'free trial' dialog -->
    <string name="trial_heading_trial">Kostenlose Probezeit</string>
    <!-- Message shown when user is starting a trial. Note: This is meant to be friendly/fun! It doesn't have to say 'until you lose your mind' -->
    <string name="trial_description_trial">Teste während der Probezeit alle Funktionen kostenlos. Danach wird die Wiedergabe jeden Tag schrittweise schneller, höchstens auf 1,15x, bis Du upgradest. Mit dem Upgrade endet die Beschleunigung sofort.</string>
    <!-- Shows how many days are left in the free trial-->
    <plurals name="trial_days_remaining">
        <item quantity="one">Noch 
      <xliff:g example="1" id="count">{count}</xliff:g>
       verbleibender Tag</item>
        <item quantity="other">Noch 
      <xliff:g example="30" id="count">{count}</xliff:g>
       verbleibende Tage</item>
    </plurals>
    <!-- Shown when the user's trial has expired -->
    <string name="trial_heading_expired">Probezeit abgelaufen</string>
    <!-- Message shown when trial has expired. Note: This is meant to be friendly/fun! It doesn't have to say 'until you lose your mind' -->
    <string name="trial_description_expired">Deine Probezeit ist abgelaufen, daher wird die Wiedergabe jeden Tag schrittweise schneller, höchstens auf 1,15x, bis Du upgradest. Mit dem Upgrade endet die Beschleunigung sofort.</string>
    <string name="trial_button_restore">Schon gekauft? Wiederherstellen</string>
    <string name="trial_restore_checking">Käufe werden geprüft …</string>
    <string name="trial_restore_not_found">Kein früherer Kauf gefunden</string>
    <!-- When a trial ends, the playback speed is increased by a small amount each day. This text shows the current playback speed -->
    <string name="trial_playback_speed">Wiedergabegeschwindigkeit: 
    <xliff:g example="1.4x" id="speed">{speed}</xliff:g></string>
    <!-- Button to upgrade from the trial version to a paid version -->
    <string name="trial_button_upgrade">Upgraden</string>
    <!-- Title of dialog shown after user has completed a purchase-->
    <string name="dialog_title_purchase_complete">Danke</string>
    <!-- Message shown in dialog after user has completed a purchase. Note: This is informal, but should reflect sincere appreciation (not just a generic 'thank you')-->
    <string name="dialog_message_purchase_complete">Du hast das Upgrade auf die Vollversion von S2 erfolgreich durchgeführt. Vielen Dank für Deine Unterstützung.</string>
</resources>
