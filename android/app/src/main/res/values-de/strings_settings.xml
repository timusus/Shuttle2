<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Einstellungen</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Grafiken leeren</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Leeren</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Dadurch werden alle zwischengespeicherten Grafiken dauerhaft entfernt</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Alle Grafiken herunterladen</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Dadurch werden alle Grafiken heruntergeladen, unabhängig von Deiner Netzwerkverbindung (Wi-Fi/Mobilfunknetz/andere)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Herunterladen</string>
    <!-- Settings option to copy debug logs to clipboard -->
    <string name="settings_logging_clipboard_name">Debug-Protokolle</string>
    <!-- Shown when the debug logs have been copied to the clipboard -->
    <string name="settings_logging_clipboard_logs_copied">Protokolle wurden in die Zwischenablage kopiert</string>
    <!-- Error message shown when copying debug logs failed, because the log file is too large -->
    <string name="settings_logging_clipboard_logs_too_large">Die Protokolldatei ist zu groß für die Zwischenablage</string>
    <!-- Error message shown when copying debug logs failed, because there are no logs -->
    <string name="settings_logging_clipboard_logs_empty">Protokolldatei ist leer</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Aussehen</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Grafik</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgets</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Privatsphäre</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Thema</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Akzent</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Neu scannen</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Ausgewählte Medienanbieter erneut scannen</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Backup</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Bibliothek sichern</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Speichert Wiedergabezähler, Favoriten, Ausgeschlossenes, Wiedergabelisten und Deine Einstellungen in einer Datei</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Bibliotheks-Backup wiederherstellen</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Fügt ein Backup mit Deiner Bibliothek zusammen und ersetzt Deine Einstellungen durch die im Backup</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Bibliotheks-Backup gespeichert</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Bibliotheks-Backup fehlgeschlagen</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Diese Backup-Datei konnte nicht gelesen werden</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Wiederherstellung abgeschlossen: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Wiederherstellung abgeschlossen: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Nichts aus diesem Backup passte zu Deiner Bibliothek</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Einstellungen wiederhergestellt; keine Songs oder Wiedergabelisten aus diesem Backup passten zu Deiner Bibliothek</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; Einstellungen wiederhergestellt</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d Song zugeordnet</item>
        <item quantity="other">%1$d Songs zugeordnet</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d Wiedergabeliste hinzugefügt oder aktualisiert</item>
        <item quantity="other">%1$d Wiedergabelisten hinzugefügt oder aktualisiert</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d Song nicht gefunden</item>
        <item quantity="other">%1$d Songs nicht gefunden</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Ausgeschlossen</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Anzeigen/Bearbeitung ausgeschlossen</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Nur Wi-Fi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Grafiken nur von externen Quellen herunterladen, wenn Wi-Fi verfügbar ist</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Nur lokal</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Lade keine Grafiken aus externen (Internet-)Quellen herunter</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Grafiken leeren</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Entfernt alle zwischengespeicherten Grafiken</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Alle Grafiken herunterladen</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Transparenz des Hintergrunds</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Änderungsprotokoll anzeigen</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Absturzbericht</string>
    <!-- Settings: Description for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_subtitle">Anonyme Absturzdaten Statistiken, die helfen Probleme zu finden und zu lösen.</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Lizenzen anzeigen</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Debugprotokollierung</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Schreibt Protokolle in eine Datei im lokalen Speicher</string>
    <!-- Settings: Title for the option to copy the debug logs to the clipboard -->
    <string name="pref_copy_debug_logs_subtitle">Debug-Protokolle kopieren</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Grafiken der Mediensitzung</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Grafiken für die Mediensitzung von Android bereitstellen. Deaktivieren, um die Cover-Anzeige im Sperrbildschirm zu verhindern.</string>
    <!-- Settings: Title for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_title">Shuffle Modus an lassen</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">Wenn eine neue Warteschlange ausgewählt wird, wird Shuffle Modus nicht ausgeschaltet</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Tag/Nacht</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Hell</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Dunkel</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Shuttle-Blau</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Cyan</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Lila</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Grün</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Orange</string>
</resources>
