<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Configuración</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Borrar portadas</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Borrar</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Esto eliminará permanentemente todas las portadas almacenadas en caché.</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Descargar todas las portadas</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Esto descargará todas las portadas, independientemente de tu conexión de red (WiFi/datos/otra)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Descargar</string>
    <!-- The name of the debug logs, as the share subject and the live log's clip label -->
    <string name="settings_logging_name">Registros de depuración</string>
    <!-- Error message shown when sharing debug logs failed, because there are no logs -->
    <string name="settings_logging_logs_empty">Archivo de registro vacío</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Apariencia</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Portada</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgets</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Privacidad</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Tema</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Acento</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Volver a buscar</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Volver a escanear los proveedores de medios seleccionados</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Copia de seguridad</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Hacer copia de seguridad de la biblioteca</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Guarda recuentos de reproducción, favoritos, exclusiones, listas de reproducción y tus ajustes en un archivo</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Restaurar copia de seguridad de la biblioteca</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Combina una copia de seguridad con tu biblioteca y reemplaza tus ajustes por los que contiene</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Copia de seguridad de la biblioteca guardada</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Error al hacer la copia de seguridad de la biblioteca</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">No se pudo leer ese archivo de copia de seguridad</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Restauración completa: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Restauración completa: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Nada de esta copia de seguridad coincidió con tu biblioteca</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Ajustes restaurados; ninguna canción ni lista de reproducción de esta copia de seguridad coincidió con tu biblioteca</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; ajustes restaurados</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d canción coincidente</item>
        <item quantity="other">%1$d canciones coincidentes</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d lista de reproducción añadida o actualizada</item>
        <item quantity="other">%1$d listas de reproducción añadidas o actualizadas</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d canción no encontrada</item>
        <item quantity="other">%1$d canciones no encontradas</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Excluidas</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Ver/Editar excluidas</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Sólo Wi-Fi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Descargar portadas de fuentes remotas sólo cuando haya Wi-Fi disponible</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Sólo locales</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">No descargar portadas de fuentes remotas (Internet)</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Borrar portada</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Elimina todas las portadas almacenadas en caché</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Descargar todas las portadas</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Opacidad de fondo</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Ver registro de cambios</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Informe de fallos</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Ver licencias</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Registro de depuración</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Escribe registros en un archivo en el disco</string>
    <!-- Settings: Title for the option to share the debug log file -->
    <string name="pref_share_debug_logs_title">Compartir registros de depuración</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Portada de sesión multimedia</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Suministra la portada de la sesión multimedia de Android. Desactivar para evitar las portadas de la pantalla de bloqueo</string>
    <!-- Settings: Title for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_title">Mantener el modo aleatorio</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">Cuando se selecciona una nueva cola, el modo aleatorio no se desactivará</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Día/Noche</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Claro</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Oscuro</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Shuttle azul</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Cian</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Púrpura</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Verde</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Naranja</string>
    <!-- Settings: Title for the automatic rescan frequency (never rescan)-->
    <string name="pref_rescan_frequency_never">Nunca</string>
    <!-- Settings: Title for the automatic rescan frequency (daily rescan)-->
    <string name="pref_rescan_frequency_daily">Diario</string>
    <!-- Settings: Title for the automatic rescan frequency (weekly rescan)-->
    <string name="pref_rescan_frequency_weekly">Semanal</string>
</resources>
