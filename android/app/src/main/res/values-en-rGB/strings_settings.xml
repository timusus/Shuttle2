<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Settings</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Clear Artwork</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Clear</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">This will permanently remove all cached artwork</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Download All Artwork</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">This will download all artwork, regardless of your network connection (WiFi/data/other)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Download</string>
    <!-- Settings option to copy debug logs to clipboard -->
    <string name="settings_logging_clipboard_name">Debug Logs</string>
    <!-- Error message shown when copying debug logs failed, because there are no logs -->
    <string name="settings_logging_clipboard_logs_empty">Log file empty</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Appearance</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Artwork</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgets</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Privacy</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Theme</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Accent</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Rescan</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Rescan the selected media providers</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Backup</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Back up library</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Save play counts, favourites, exclusions, playlists and your settings to a file</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Restore library backup</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Merge a backup into your library and replace your settings with the ones it holds</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Library backup saved</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Library backup failed</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Could not read that backup file</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Restore complete: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Restore complete: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Nothing in this backup matched your library</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Settings restored; no songs or playlists in this backup matched your library</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; settings restored</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d song matched</item>
        <item quantity="other">%1$d songs matched</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d playlist added or updated</item>
        <item quantity="other">%1$d playlists added or updated</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d song not found</item>
        <item quantity="other">%1$d songs not found</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Excluded</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">View/Edit excluded</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Wi-Fi only</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Only download artwork from remote sources when Wi-Fi is available</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Local only</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Don\'t download artwork from remote (internet) sources</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Clear artwork</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Removes all cached artwork</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Download all artwork</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Background opacity</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">View changelog</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Crash reporting</string>
    <!-- Settings: Description for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_subtitle">Anonymous crash statistics, which help to track down and resolve bugs</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">View licenses</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Debug logging</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Writes debug logs to a file on disk</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Media session artwork</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Supply artwork to Android\'s Media Session. Disable to prevent lockscreen artwork</string>
    <!-- Settings: Title for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_title">Keep shuffle mode</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">When a new queue is selected, shuffle mode won\'t be disabled</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Day/Night</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Light</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Dark</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Shuttle blue</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Cyan</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Purple</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Green</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Orange</string>
</resources>
