<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Shown when text is required in a text field -->
    <string name="validation_field_required">Wymagany</string>
    <!-- Shown when an unexpected error occurs -->
    <string name="error_unexpected">Wystąpił nieoczekiwany błąd</string>
    <!-- Shown when an unknown error occurs -->
    <string name="error_unknown">Wystąpił nieznany błąd</string>
    <!-- Shown when songs are added to the queue -->
    <plurals name="queue_songs_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       utwór został dodany do kolejki</item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g>
       utwory dodane do kolejki</item>
        <item quantity="few"><xliff:g example="30" id="count">%1$d</xliff:g>
       utwory dodane do kolejki</item>
        <item quantity="many"><xliff:g example="30" id="count">%1$d</xliff:g>
       utwory dodane do kolejki</item>
    </plurals>
    <!-- Shown when current playback queue is added to a playlist -->
    <string name="playlist_queue_added">Dodano kolejkę do: 
    <xliff:g example="Favourites" id="playlist_name">%1$s</xliff:g></string>
    <!-- Shown when songs are added to a playlist -->
    <plurals name="playlist_songs_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       utwór dodany do 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other">Utwory dodane do 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g>
      : 
      <xliff:g example="30" id="count">%1$d</xliff:g></item>
