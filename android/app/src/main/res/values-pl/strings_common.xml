    <string name="playlist_list_empty">Brak list odtwarzania</string>
    <!-- Button to skip to the next track -->
    <string name="button_skip_next">Pomiń następne</string>
    <!-- Button to play/pause the current song-->
    <string name="button_toggle_playback">Przełącz odtwarzanie</string>
    <!-- Button to skip to the previous track-->
    <string name="button_skip_previous">Pomiń poprzedni</string>
    <!-- 'Loading' text. Shown on various screens as their content is loading-->
    <string name="loading">Ładowanie…</string>
    <!-- Shown when the playback queue is empty -->
    <string name="queue_empty">Kolejka pusta</string>
