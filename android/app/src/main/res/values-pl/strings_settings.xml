<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Ustawienia</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Wyczyść grafikę</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Wyczyść</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Spowoduje to trwałe usunięcie całej grafiki z pamięci podręcznej</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Pobierz całą grafikę</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Spowoduje to pobranie całej grafiki, niezależnie od połączenia sieciowego (WiFi/dane/inne)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Ściągnij</string>
    <!-- The name of the debug logs, as the share subject and the live log's clip label -->
    <string name="settings_logging_name">Dzienniki debugowania</string>
    <!-- Error message shown when sharing debug logs failed, because there are no logs -->
    <string name="settings_logging_logs_empty">Plik dziennika jest pusty</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Pokaż</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Grafika</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgety</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Prywatność</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Motyw</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Akcent</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Skanuj ponownie</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Ponownie przeskanuj wybranych dostawców mediów</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Kopia zapasowa</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Utwórz kopię zapasową biblioteki</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Zapisz licznik odtworzeń, ulubione, wykluczenia, playlisty i swoje ustawienia do pliku</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Przywróć kopię zapasową biblioteki</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Scal kopię zapasową z biblioteką i zastąp ustawienia tymi z kopii</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Kopia zapasowa biblioteki zapisana</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Nie udało się utworzyć kopii zapasowej biblioteki</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Nie można odczytać tego pliku kopii zapasowej</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Przywracanie zakończone: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Przywracanie zakończone: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Nic z tej kopii zapasowej nie pasowało do Twojej biblioteki</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Przywrócono ustawienia; żaden utwór ani playlista z tej kopii nie pasował do Twojej biblioteki</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; przywrócono ustawienia</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">Dopasowano %1$d utwór</item>
        <item quantity="few">Dopasowano %1$d utwory</item>
        <item quantity="many">Dopasowano %1$d utworów</item>
        <item quantity="other">Dopasowano %1$d utworów</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">Dodano lub zaktualizowano %1$d playlistę</item>
        <item quantity="few">Dodano lub zaktualizowano %1$d playlisty</item>
        <item quantity="many">Dodano lub zaktualizowano %1$d playlist</item>
        <item quantity="other">Dodano lub zaktualizowano %1$d playlist</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">Nie znaleziono %1$d utworu</item>
        <item quantity="few">Nie znaleziono %1$d utworów</item>
        <item quantity="many">Nie znaleziono %1$d utworów</item>
        <item quantity="other">Nie znaleziono %1$d utworów</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Wyłączony</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Wyświetl/edytuj wykluczone</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Tylko wifi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Pobieraj grafiki ze zdalnych źródeł tylko wtedy, gdy dostępna jest sieć Wi-Fi</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Tylko lokalnie</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Nie pobieraj grafiki ze zdalnych (internetowych) źródeł</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Wyraźna grafika</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Usuwa całą buforowaną grafikę</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Pobierz całą grafikę</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Krycie tła</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Przeglądać zmiany rejestru</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Zgłaszanie awarii</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Wyświetl licencje</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Rejestrowanie debugowania</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Zapisuje dzienniki do pliku na dysku</string>
    <!-- Settings: Title for the option to share the debug log file -->
    <string name="pref_share_debug_logs_title">Udostępnij dzienniki debugowania</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Grafika z sesji medialnych</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Dostarcz grafikę do sesji multimedialnej Androida. Wyłącz, aby uniemożliwić wyświetlanie grafiki na ekranie blokady</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Dzień/Noc</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Jasny</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Ciemny</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Niebieski Shuttle</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Cyjan</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Purpurowy</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Zielony</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Pomarańczowy</string>
</resources>
