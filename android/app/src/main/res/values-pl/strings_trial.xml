<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The title of the menu button. When clicked, will show the 'free trial' dialog, with an option for the user to upgrade-->
    <string name="menu_trial">Próba</string>
    <!-- The heading of the 'free trial' dialog -->
    <string name="trial_heading_trial">Bezpłatna wersja próbna</string>
    <!-- Shows how many days are left in the free trial-->
    <plurals name="trial_days_remaining">
        <item quantity="one">Pozostało 
      <xliff:g example="1" id="count">{count}</xliff:g>
       dzień</item>
        <item quantity="other">Pozostało 
      <xliff:g example="30" id="count">{count}</xliff:g>
       dni</item>
        <item quantity="few">Pozostało 
      <xliff:g example="30" id="count">{count}</xliff:g>
       dni</item>
        <item quantity="many">Pozostało 
      <xliff:g example="30" id="count">{count}</xliff:g>
       dni</item>
    </plurals>
    <!-- Shown when the user's trial has expired -->
    <string name="trial_heading_expired">Wygasł okres próbny</string>
    <!-- Button to upgrade from the trial version to a paid version -->
    <string name="trial_button_upgrade">Aktualizacja</string>
    <!-- Title of dialog shown after user has completed a purchase-->
    <string name="dialog_title_purchase_complete">Dziękuję Ci</string>
    <!-- Message shown in dialog after user has completed a purchase. Note: This is informal, but should reflect sincere appreciation (not just a generic 'thank you')-->
    <string name="dialog_message_purchase_complete">Udało Ci się uaktualnić do pełnej wersji S2. Dziękuję bardzo za wsparcie aplikacji.</string>
</resources>
