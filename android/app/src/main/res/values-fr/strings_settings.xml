<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Paramètres</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Effacer l\'illustration</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Supprimer</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Cela supprimera définitivement toutes les illustrations mises en cache</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Télécharger toutes les illustrations</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Ceci téléchargera toutes les illustrations, quelle que soit votre connexion réseau (WiFi/données/autre)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Télécharger</string>
    <!-- The name of the debug logs, as the share subject and the live log's clip label -->
    <string name="settings_logging_name">Journaux de Shuttle Music</string>
    <!-- Error message shown when sharing debug logs failed, because there are no logs -->
    <string name="settings_logging_logs_empty">Fichier journal vide</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Apparence</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Pochette</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgets</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Confidentialité</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Thème</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Accent</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Rescanner</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Rescanner le fournisseur de chansons selectionné</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Sauvegarde</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Sauvegarder la bibliothèque</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Enregistre les compteurs d\'écoute, les favoris, les exclusions, les listes de lecture et vos paramètres dans un fichier</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Restaurer une sauvegarde de la bibliothèque</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Fusionne une sauvegarde avec votre bibliothèque et remplace vos paramètres par ceux qu\'elle contient</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Sauvegarde de la bibliothèque enregistrée</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Échec de la sauvegarde de la bibliothèque</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Impossible de lire ce fichier de sauvegarde</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Restauration terminée : %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Restauration terminée : %1$s, %2$s ; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Rien dans cette sauvegarde ne correspond à votre bibliothèque</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Paramètres restaurés ; aucune chanson ni liste de lecture de cette sauvegarde ne correspond à votre bibliothèque</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s ; paramètres restaurés</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d chanson correspondante</item>
        <item quantity="other">%1$d chansons correspondantes</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d liste de lecture ajoutée ou mise à jour</item>
        <item quantity="other">%1$d listes de lecture ajoutées ou mises à jour</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d chanson introuvable</item>
        <item quantity="other">%1$d chansons introuvables</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Exclus</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Afficher/modifier exclus</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Wi-Fi uniquement</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Télécharger uniquement les pochettes à partir de sources distantes lorsque le Wi-Fi est disponible</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Local uniquement</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Ne pas télécharger de pochettes à partir de sources distantes (Internet)</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Effacer la pochette</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Supprime toutes les pochettes mises en cache</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Télécharger toutes les pochettes</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Opacité de l\'arrière-plan</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Voir le journal des modifications</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Rapports de plantage</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Afficher les licences</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Journalisation des fichiers</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Écrit les journaux dans un fichier sur le disque</string>
    <!-- Settings: Title for the option to share the debug log file -->
    <string name="pref_share_debug_logs_title">Partager les journaux de débogage</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Pochette de la session médiatique</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Fournir des pochettes à la session multimédia d\'Android. Désactiver pour empêcher les illustrations de l\'écran de verrouillage</string>
    <!-- Settings: Title for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_title">Maintenir le mode aléatoire</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">Quand une nouvelle file est sélectionnée, le mode aléatoire ne sera pas désactivé</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Jour/Nuit</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Lumière</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Sombre</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Bleu Navette</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Cyan</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Mauve</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Vert</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Orange</string>
</resources>
