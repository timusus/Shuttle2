<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Instellingen</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Illustraties wissen</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Wissen</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Hiermee worden alle in de cache opgeslagen illustraties definitief verwijderd</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Download alle illustraties</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Hiermee download je alle illustraties, ongeacht je netwerkverbinding (wifi/data/overig)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Downloaden</string>
    <!-- Settings option to copy debug logs to clipboard -->
    <string name="settings_logging_clipboard_name">Debug-logs</string>
    <!-- Shown when the debug logs have been copied to the clipboard -->
    <string name="settings_logging_clipboard_logs_copied">Logboeken naar klembord gekopieerd</string>
    <!-- Error message shown when copying debug logs failed, because the log file is too large -->
    <string name="settings_logging_clipboard_logs_too_large">Logbestand is te groot voor klembord</string>
    <!-- Error message shown when copying debug logs failed, because there are no logs -->
    <string name="settings_logging_clipboard_logs_empty">Logbestand leeg</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Weergave</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Illustraties</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widgets</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Privacy</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Thema</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Accent</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Opnieuw scannen</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Scan de geselecteerde mediaproviders opnieuw</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Back-up</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Back-up van bibliotheek maken</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Sla afspeelstatistieken, favorieten, uitgesloten nummers, afspeellijsten en je instellingen op in een bestand</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Back-up van bibliotheek terugzetten</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Voegt een back-up samen met je bibliotheek en vervangt je instellingen door die uit de back-up</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Back-up van bibliotheek opgeslagen</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Back-up van bibliotheek mislukt</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Kon dat back-upbestand niet lezen</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Terugzetten voltooid: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Terugzetten voltooid: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Niets in deze back-up kwam overeen met je bibliotheek</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Instellingen teruggezet; geen nummers of afspeellijsten in deze back-up kwamen overeen met je bibliotheek</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; instellingen teruggezet</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d nummer kwam overeen</item>
        <item quantity="other">%1$d nummers kwamen overeen</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d afspeellijst toegevoegd of bijgewerkt</item>
        <item quantity="other">%1$d afspeellijsten toegevoegd of bijgewerkt</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d nummer niet gevonden</item>
        <item quantity="other">%1$d nummers niet gevonden</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Uitgesloten</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Bekijk/bewerk uitgesloten</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Alleen wifi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Download illustraties van externe bronnen alleen als wifi beschikbaar is</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Alleen lokaal</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Download geen illustraties van externe (internet)bronnen</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Wis illustraties</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Verwijdert alle in het cachegeheugen opgeslagen illustraties</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Download alle illustraties</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Achtergronddekking</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Bekijk log met wijzigingen</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Crashrapportage</string>
    <!-- Settings: Description for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_subtitle">Anonieme crashstatistieken die helpen bij het opsporen en oplossen van fouten</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Bekijk licenties</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Logboekregistratie foutopsporing</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Schrijft logboeken naar een bestand op schijf</string>
    <!-- Settings: Title for the option to copy the debug logs to the clipboard -->
    <string name="pref_copy_debug_logs_subtitle">Kopieer debug-logs</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Mediasessie illustraties</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Lever illustraties aan voor de mediasessie van Android. Schakel dit uit om illustraties op het vergrendelscherm te voorkomen</string>
    <!-- Settings: Title for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_title">Behoud shuffle-modus</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">Als er een nieuwe wachtrij wordt geselecteerd wordt de shuffle-modus niet uitgeschakeld</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Dag/nacht</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Licht</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Donker</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Shuttle-blauw</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Cyaan</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Paars</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Groen</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Oranje</string>
</resources>
