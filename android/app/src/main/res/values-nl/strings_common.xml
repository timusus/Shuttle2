<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Shown when text is required in a text field -->
    <string name="validation_field_required">Vereist</string>
    <!-- Shown when an unexpected error occurs -->
    <string name="error_unexpected">Er is een onverwachte fout opgetreden</string>
    <!-- Shown when an unknown error occurs -->
    <string name="error_unknown">Er is een onbekende fout opgetreden</string>
    <!-- Shown when songs are added to the queue -->
    <plurals name="queue_songs_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       nummer toegevoegd aan wachtrij</item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g>
       nummers toegevoegd aan wachtrij</item>
    </plurals>
    <!-- Shown when current playback queue is added to a playlist -->
    <string name="playlist_queue_added">Wachtrij toegevoegd aan 
    <xliff:g example="Favourites" id="playlist_name">%1$s</xliff:g></string>
    <!-- Shown when songs are added to a playlist -->
    <plurals name="playlist_songs_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       nummer toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g>
       nummers toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when albums are added to a playlist -->
    <plurals name="playlist_albums_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       album toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g>
       albums toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when artists are added to a playlist -->
    <plurals name="playlist_artists_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       artiest toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g>
       artiesten toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when genres are added to a playlist -->
    <plurals name="playlist_genres_added">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g>
       genre toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g example="30" id="count">%1$d</xliff:g>
       genre toegevoegd aan 
      <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- The disc number for this album-->
    <string name="disc_number">Schijf 
    <xliff:g example="1" id="disc_number">%1$d</xliff:g></string>
    <!-- Shown when the songs list finishes loading, and there are no songs-->
    <string name="song_list_empty">Geen nummers</string>
    <!-- Shown when the albums list finishes loading, and there are no songs-->
    <string name="album_list_empty">Geen albums</string>
    <!-- Shown when the artists list finishes loading, and there are no songs-->
    <string name="artist_list_empty">Geen artiesten</string>
    <!-- Shown when the genres list finishes loading, and there are no songs-->
    <string name="genre_list_empty">Geen genres</string>
    <!-- Shown when the playlists list finishes loading, and there are no songs-->
    <string name="playlist_list_empty">Geen afspeellijsten</string>
    <!-- Button to skip to the next track -->
    <string name="button_skip_next">Volgende overslaan</string>
    <!-- Button to play/pause the current song-->
    <string name="button_toggle_playback">Schakelen tussen afspelen</string>
    <!-- Button to skip to the previous track-->
    <string name="button_skip_previous">Vorige overslaan</string>
    <!-- Shown when the playback queue is empty -->
    <string name="queue_empty">Wachtrij leeg</string>
</resources>
