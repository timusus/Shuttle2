<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The title of the menu button. When clicked, will show the 'free trial' dialog, with an option for the user to upgrade-->
    <string name="menu_trial">Trial</string>
    <!-- The heading of the 'free trial' dialog -->
    <string name="trial_heading_trial">Free Trial</string>
    <!-- Message shown during the free trial -->
    <string name="trial_description_trial">Try every feature free during the trial. When it ends, playback gradually speeds up each day, to at most 1.15x, until you upgrade. Upgrading stops the speed-up straight away.</string>
    <!-- Shows how many days are left in the free trial-->
    <plurals name="trial_days_remaining">
        <item quantity="one"><xliff:g example="1" id="count">{count}</xliff:g> day remaining</item>
        <item quantity="other"><xliff:g example="30" id="count">{count}</xliff:g> days remaining</item>
    </plurals>
    <!-- Shown when the user's trial has expired -->
    <string name="trial_heading_expired">Trial Expired</string>
    <!-- Message shown when trial has expired -->
    <string name="trial_description_expired">Your trial has ended, so playback gradually speeds up each day, to at most 1.15x, until you upgrade. Upgrading stops the speed-up straight away.</string>
    <!-- Button on the trial-expired dialog for users who already purchased, to re-check their purchase with Google Play -->
    <string name="trial_button_restore">Already bought? Restore</string>
    <!-- Toast shown right after tapping the Restore button -->
    <string name="trial_restore_checking">Checking for purchases…</string>
    <!-- Toast shown when the Restore check finds no purchase -->
    <string name="trial_restore_not_found">No previous purchase found</string>
    <!-- When a trial ends, the playback speed is increased by a small amount each day. This text shows the current playback speed -->
    <string name="trial_playback_speed">Playback speed: <xliff:g example="1.4x" id="speed">{speed}</xliff:g></string>
    <!-- Button to upgrade from the trial version to a paid version -->
    <string name="trial_button_upgrade">Upgrade</string>
    <!-- Title of dialog shown after user has completed a purchase-->
    <string name="dialog_title_purchase_complete">Thank You</string>
    <!-- Message shown in dialog after user has completed a purchase. Note: This is informal, but should reflect sincere appreciation (not just a generic 'thank you')-->
    <string name="dialog_message_purchase_complete">You have successfully upgraded to the full version of S2. Thank you so much for supporting the app.</string>
</resources>
