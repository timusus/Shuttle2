<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Settings</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Clear Artwork</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Clear</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">This will permanently remove all cached artwork</string>
    <!-- Dialog title shown before restoring a library backup -->
    <string name="settings_dialog_title_restore_backup">Restore backup</string>
    <!-- Dialog message shown before restoring a library backup: what will be replaced and what is kept -->
    <string name="settings_dialog_message_restore_backup">Your settings will be replaced with the ones saved in the backup. Play counts, favourites and playlists are merged, and newer data on this device is kept. Server sign-ins are not part of a backup.</string>
    <!-- Button shown to confirm restoring a library backup, which opens the file picker -->
    <string name="settings_dialog_button_restore_backup">Choose file</string>
    <!-- Settings option to download all artwork (album/artist images)-->
