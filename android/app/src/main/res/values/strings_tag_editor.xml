<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The number of songs being edited with the tag (metadata) editor-->
    <plurals name="edit_tags_editing_count_songs">
        <item quantity="one">Editing <xliff:g example="1" id="count">%1$d</xliff:g> song</item>
        <item quantity="other">Editing <xliff:g example="5" id="count">%1$d</xliff:g> songs</item>
    </plurals>
    <!-- The title of the 'edit tags' dialog. If 'tags' doesn't apply in your language, you could use 'metadata' or 'info' instead. -->
    <string name="edit_tags_action">Edit Tags</string>
    <!-- When editing tags, if multiple songs are being edited at the same time, this indicates that a field has multiple values.
    For example, editing two songs, which have two different artists. Editing the artist field will overwrite the artist for both songs. There are 'multiple values' for artist. -->
    <string name="edit_tags_multiple_values">Multiple values</string>
    <!-- Shown when the tag editor is in progress, reading tags (metadata) from the selected songs -->
    <string name="edit_tags_reading_tags">Reading tags <xliff:g example="1" id="progress">%1$d</xliff:g> / <xliff:g example="1" id="count">%2$d</xliff:g></string>
    <!-- Shown when the tag editor is in progress, writing tags (metadata) to the selected songs -->
    <string name="edit_tags_writing_tags">Writing tags <xliff:g example="1" id="progress">%1$d</xliff:g> / <xliff:g example="1" id="count">%2$d</xliff:g></string>
    <!-- Shown when the tag editor fails to read the tags (metadata) of a song -->
    <string name="edit_tags_read_failed">The selected song tags could not be read</string>
    <!-- Shown when the tag editor successfully writes the tags (metadata) of the songs -->
    <plurals name="edit_tags_success">
        <item quantity="one">Successfully updated <xliff:g example="5" id="count">%1$d</xliff:g> song</item>
        <item quantity="other">Successfully updated <xliff:g example="5" id="count">%1$d</xliff:g> songs</item>
    </plurals>
    <!-- Shown when the tag editor fails to write the tags (metadata) to the songs-->
    <plurals name="edit_tags_failure">
        <item quantity="one">Failed to update song</item>
        <item quantity="other">Failed to update <xliff:g example="5" id="count">%1$d</xliff:g> of <xliff:g example="5" id="total">%2$d</xliff:g> songs</item>
    </plurals>
    <!-- The hint (placeholder) text shown in the 'title' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_title">Title</string>
    <!-- The hint (placeholder) text shown in the 'artist' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_artist">Artist</string>
    <!-- The hint (placeholder) text shown in the 'album' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_album">Album</string>
    <!-- The hint (placeholder) text shown in the 'album artist' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_album_artist">Album Artist</string>
    <!-- The hint (placeholder) text shown in the 'year' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_year">Year</string>
    <!-- The hint (placeholder) text shown in the 'track' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_track">Track</string>
    <!-- The hint (placeholder) text shown in the 'track total' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_track_total">Track Total</string>
    <!-- The hint (placeholder) text shown in the 'disc' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_disc">Disc</string>
    <!-- The hint (placeholder) text shown in the 'disc total' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_disc_total">Disc Total</string>
    <!-- The hint (placeholder) text shown in the 'genres' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_genres">Genres</string>
    <!-- The hint (placeholder) text shown in the 'lyrics' text field, when editing the tags (metadata) -->
    <string name="edit_tags_hint_lyrics">Lyrics</string>
    <!-- Shown above the tag editor's fields when some of the chosen songs can't be edited (their files can't be read, or aren't on a storage the app can write to). Those songs are listed below it. -->
    <plurals name="edit_tags_skipped">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> song can\'t be edited and will be left as it is</item>
        <item quantity="other"><xliff:g example="2" id="count">%1$d</xliff:g> songs can\'t be edited and will be left as they are</item>
    </plurals>
    <!-- Content description of the button beside a tag editor field that puts back the field's original value. -->
    <string name="edit_tags_reset_field">Reset <xliff:g example="Album" id="field">%1$s</xliff:g></string>
    <!-- Title of the dialog shown when leaving the tag editor with unsaved changes -->
    <string name="edit_tags_discard_title">Discard your changes?</string>
    <!-- Button in the unsaved-changes dialog that leaves the tag editor without saving -->
    <string name="edit_tags_discard">Discard</string>
    <!-- Button in the unsaved-changes dialog that goes back to editing -->
    <string name="edit_tags_keep_editing">Keep editing</string>
    <!-- Heading over the tag editor's song fields (title, artist, genres) -->
    <string name="edit_tags_section_song">Song</string>
    <!-- Heading over the tag editor's album fields (album, album artist, year) -->
    <string name="edit_tags_section_album">Album</string>
    <!-- Heading over the tag editor's track and disc number fields -->
    <string name="edit_tags_section_numbering">Numbering</string>
    <!-- Heading over the tag editor's lyrics field -->
    <string name="edit_tags_section_lyrics">Lyrics</string>
</resources>
