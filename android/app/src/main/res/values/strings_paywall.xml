<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the Shuttle Music Pro screen, and its row in Settings -->
    <string name="paywall_title">Shuttle Music Pro</string>
    <!-- Summary of the Shuttle Music Pro row in Settings -->
    <string name="paywall_settings_summary">Servers, Android Auto, batch tag editing and ReplayGain</string>
    <!-- Summary of the Shuttle Music Pro row in Settings when the user has Pro -->
    <string name="paywall_settings_summary_pro">Thank you for your support</string>
    <!-- Shuttle Music Pro screen: status while Google Play hasn't yet said whether the user owns Shuttle Music Pro (e.g. offline) -->
    <string name="paywall_status_checking">Checking your purchases with Google Play…</string>
    <!-- Shuttle Music Pro screen: status when the user has never had the free trial -->
    <string name="paywall_status_trial_available">Try Shuttle Music Pro free for 14 days. The trial starts the first time you use a Pro feature.</string>
    <!-- Shuttle Music Pro screen: before and during the trial, what stops once it ends -->
    <string name="paywall_trial_terms">After the trial, server songs, Android Auto, batch tag editing and turning on ReplayGain ask you to upgrade. Downloaded songs, music on this phone and your saved settings keep working.</string>
    <!-- Shuttle Music Pro screen: status when the free trial has ended -->
    <string name="paywall_status_trial_ended">Your free trial has ended. Upgrade to keep using Shuttle Music Pro.</string>
    <!-- Shuttle Music Pro screen: status during the trial, e.g. '3 days left in your free trial' -->
    <plurals name="paywall_status_trial">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> day left in your free trial</item>
        <item quantity="other"><xliff:g example="3" id="count">%1$d</xliff:g> days left in your free trial</item>
    </plurals>
    <!-- Shuttle Music Pro screen: status when the user has Pro -->
    <string name="paywall_status_pro">You have Shuttle Music Pro. Thank you for supporting Shuttle Music.</string>
    <!-- Shuttle Music Pro screen: heading of the list of what Pro unlocks -->
    <string name="paywall_benefits_heading">What you get</string>
    <string name="paywall_benefit_streaming">Stream from Jellyfin, Emby, Plex and Navidrome</string>
    <string name="paywall_benefit_downloads">Download server songs for offline listening</string>
    <string name="paywall_benefit_android_auto">Browse and play your library in Android Auto</string>
    <string name="paywall_benefit_batch_tag_edit">Edit the tags of many songs at once</string>
    <string name="paywall_benefit_replay_gain">ReplayGain volume levelling by track or album</string>
    <string name="paywall_benefit_free">Local playback, Chromecast, the equalizer, editing one song\'s tags and downloaded songs stay free</string>
    <!-- Title of the dialog shown once, when the first use of a Shuttle Music Pro feature starts the free trial -->
    <string name="trial_disclosure_title">Your free trial has started</string>
    <!-- Trial started dialog: what started it, when it was streaming from a server -->
    <string name="trial_disclosure_lead_servers">Playing from your server started your 14 day free trial of Shuttle Music Pro.</string>
    <!-- Trial started dialog: what started it, when it was connecting to Android Auto -->
    <string name="trial_disclosure_lead_android_auto">Connecting to Android Auto started your 14 day free trial of Shuttle Music Pro.</string>
    <!-- Trial started dialog: what started it, when it was editing several songs' tags at once -->
    <string name="trial_disclosure_lead_batch_tag_edit">Editing several songs\' tags at once started your 14 day free trial of Shuttle Music Pro.</string>
    <!-- Trial started dialog: what started it, when it was turning on ReplayGain -->
    <string name="trial_disclosure_lead_advanced_audio">Turning on ReplayGain started your 14 day free trial of Shuttle Music Pro.</string>
    <!-- Trial started dialog: the terms, the same whichever feature started it -->
    <string name="trial_disclosure_body">Servers, Android Auto, batch tag editing and ReplayGain are all unlocked until it ends. Nothing is charged. After that, these features ask you to upgrade; everything else keeps working, and your settings are kept.</string>
    <!-- Trial started dialog: the button that closes it -->
    <string name="trial_disclosure_ok">Got it</string>
    <!-- Shuttle Music Pro screen: heading of the plans -->
    <string name="paywall_plans_heading">Choose a plan</string>
    <string name="paywall_plan_lifetime">Lifetime</string>
    <string name="paywall_plan_annual">Yearly</string>
    <!-- Shuttle Music Pro screen: the renewal terms under the yearly plan -->
    <string name="paywall_annual_terms">Renews yearly · cancel anytime in Google Play</string>
    <!-- Shuttle Music Pro screen: the lifetime plan's price, e.g. '$14.99 once' -->
    <string name="paywall_price_once"><xliff:g example="$14.99" id="price">%1$s</xliff:g> once</string>
    <!-- Shuttle Music Pro screen: badge on the lifetime plan -->
    <string name="paywall_plan_best_value">Best value</string>
    <!-- Shuttle Music Pro screen: shown instead of a price while prices load -->
    <string name="paywall_price_loading">Loading price…</string>
    <!-- Shuttle Music Pro screen: shown instead of a price when prices can't be loaded -->
    <string name="paywall_price_unavailable">Price unavailable</string>
    <!-- Shuttle Music Pro screen: title when Google Play prices can't be loaded -->
    <string name="paywall_prices_unavailable">Couldn\'t load prices</string>
    <!-- Shuttle Music Pro screen: message when Google Play prices can't be loaded -->
    <string name="paywall_prices_unavailable_message">Check your connection and that Google Play is signed in.</string>
    <string name="paywall_retry">Retry</string>
    <!-- Shuttle Music Pro screen: the purchase button -->
    <string name="paywall_purchase">Get Shuttle Music Pro</string>
    <!-- Shuttle Music Pro screen: the main button before the trial has started; opens Sources to add a server -->
    <string name="paywall_start_trial">Start free trial</string>
    <!-- Shuttle Music Pro screen: the purchase button before the trial has started, below Start free trial -->
    <string name="paywall_buy_now">Buy now</string>
    <!-- Shuttle Music Pro screen: footer link to the privacy policy -->
    <string name="paywall_privacy_policy">Privacy policy</string>
    <string name="paywall_restore">Restore purchases</string>
    <!-- Shuttle Music Pro screen: opens Google Play's screen for entering a promo code -->
    <string name="paywall_redeem_code">Redeem a code</string>
    <string name="paywall_manage_subscription">Manage subscription</string>
    <string name="paywall_purchase_failed">Couldn\'t open Google Play. Please try again.</string>
    <!-- Shuttle Music Pro screen: snackbar once a purchase or promo code has gone through -->
    <string name="paywall_thank_you">Thank you for supporting Shuttle Music!</string>
    <string name="paywall_restored">Your purchase has been restored</string>
    <string name="paywall_nothing_to_restore">No Shuttle Music Pro purchase found for this Google account</string>
    <string name="paywall_restore_failed">Couldn\'t reach Google Play. Please try again.</string>
    <!-- Add-server sign-in dialog: shown to Free users before they connect to a Jellyfin, Emby, Plex or Subsonic server -->
    <string name="paywall_server_disclosure">Streaming from Jellyfin, Emby, Plex and Navidrome is part of Shuttle Music Pro. Free for 14 days.</string>
</resources>
