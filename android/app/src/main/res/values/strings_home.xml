<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Button to shuffle all songs -->
    <string name="btn_shuffle">Shuffle</string>
    <!-- Home: content description for the top bar button that shuffles every song in the library -->
    <string name="home_shuffle_all">Shuffle all</string>
    <!-- Home: the kind of item a tile shows, under its title in Jump back in and before its detail on a mixed shelf -->
    <string name="home_type_album">Album</string>
    <!-- Home: the kind of item a tile shows (an artist) -->
    <string name="home_type_artist">Artist</string>
    <!-- Home: the kind of item a tile shows (a playlist, including the built-in smart playlists) -->
    <string name="home_type_playlist">Playlist</string>
    <!-- Home: the kind of item a tile shows (a genre) -->
    <string name="home_type_genre">Genre</string>
    <!-- Home: a mixed shelf tile's subtitle, the kind of item then its detail; %1$s is e.g. "Artist", %2$s e.g. "12 albums" -->
    <string name="home_tile_subtitle"><xliff:g example="Artist" id="type">%1$s</xliff:g> · <xliff:g example="12 albums" id="detail">%2$s</xliff:g></string>
    <!-- Home: content description of the play button at the end of a Jump back in cell; %1$s is the album, artist or playlist -->
    <string name="home_play_item">Play <xliff:g example="OK Computer" id="name">%1$s</xliff:g></string>
    <!-- Home: content description of the shuffle button at the end of a Jump back in genre cell; %1$s is the genre -->
    <string name="home_shuffle_item">Shuffle <xliff:g example="Jazz" id="name">%1$s</xliff:g></string>
    <!-- Home: long-press menu and TalkBack action that opens the album a tile shows -->
    <string name="home_go_to_album">Go to album</string>
    <!-- Home: long-press menu and TalkBack action that opens the artist a tile shows -->
    <string name="home_go_to_artist">Go to artist</string>
    <!-- Home: long-press menu and TalkBack action that opens the playlist a tile shows -->
    <string name="home_go_to_playlist">Go to playlist</string>
    <!-- Home: long-press menu and TalkBack action that opens the genre a tile shows -->
    <string name="home_go_to_genre">Go to genre</string>
    <!-- Home: button at the end of a section header that opens the whole list the section samples -->
    <string name="home_see_all">See all</string>
    <!-- Home: hint under Shuffle all before anything has been played, saying the sections fill in with listening -->
    <string name="home_cold_start_hint">Home learns from what you play: your albums, artists and genres show up here as you listen.</string>
    <!-- Home: section of the albums, artists, playlists and genres the user last played from -->
    <string name="home_jump_back_in">Jump back in</string>
    <!-- Home: section of what the user tends to play around this hour, shown in the morning -->
    <string name="home_this_morning">This morning</string>
    <!-- Home: section of what the user tends to play around this hour, shown in the afternoon -->
    <string name="home_this_afternoon">This afternoon</string>
    <!-- Home: section of what the user tends to play around this hour, shown in the evening and at night -->
    <string name="home_tonight">Tonight</string>
    <!-- Home: section of the albums and artists the user has listened to on the most days in the last four weeks -->
    <string name="home_heavy_rotation">Heavy rotation</string>
    <!-- Home: section of albums the user used to play a lot but hasn't for months -->
    <string name="home_rediscover">Rediscover</string>
    <!-- Home: section of albums most recently added to the library -->
    <string name="home_recently_added">Recently added</string>
    <!-- Home: section of genre tiles; tapping one shuffles that genre -->
    <string name="home_genre_picks">Genre picks</string>
    <!-- Home: under a Jump back in item, how far into it the user got last time, e.g. "Track 5 of 12" -->
    <string name="home_item_progress">Track %1$s of %2$s</string>
    <!-- Home: long-press action on a Jump back in item, playing it from its first song rather than where the user left off -->
    <string name="home_play_from_start">Play from start</string>
    <!-- Home: one line under the Jump back in header -->
    <string name="home_jump_back_in_subtitle">Pick up where you left off</string>
    <!-- Home: one line under the This morning / This afternoon / Tonight header -->
    <string name="home_around_this_time_subtitle">What you often play at this time of day</string>
    <!-- Home: one line under the Heavy rotation header -->
    <string name="home_heavy_rotation_subtitle">What you\'ve played most in the last 4 weeks</string>
    <!-- Home: one line under the Rediscover header -->
    <string name="home_rediscover_subtitle">Albums you haven\'t played in a while</string>
    <!-- Home: one line under the Recently added header -->
    <string name="home_recently_added_subtitle">The newest additions to your library</string>
    <!-- Home: one line under the Genre picks header when it shows genres the user has played -->
    <string name="home_genre_picks_subtitle">Genres you\'ve been playing</string>
    <!-- Home: one line under the Genre picks header when it shows the library's largest genres (nothing played yet) -->
    <string name="home_genre_picks_largest_subtitle">The biggest genres in your library</string>
    <!-- Home: card title telling the user this version has release notes they haven't seen -->
    <string name="home_whats_new_title">What\'s new in Shuttle Music</string>
    <!-- Home: card message under the What's new title; %1$s is the app version -->
    <string name="home_whats_new_message">See what changed in version <xliff:g example="2026.09.25" id="version">%1$s</xliff:g></string>
    <!-- Home: button on the What's new card that opens the release notes -->
    <string name="home_whats_new_open">See what\'s new</string>
    <!-- Home: content description for the button that dismisses the What's new card -->
    <string name="home_whats_new_dismiss">Dismiss</string>
    <!-- Home: title of the empty state when the library has no songs -->
    <string name="home_empty_title">No music yet</string>
    <!-- Home: message of the empty state when the library has no songs -->
    <string name="home_empty_message">Music on this device and on servers you connect shows up here</string>
    <!-- Home: one-time snackbar telling an upgrader analytics is now on, since it never was before (#481) -->
    <string name="home_analytics_notice_message">Shuttle Music now shares anonymous usage data to help improve the app. You can turn this off in Settings.</string>
    <!-- Home: action on the analytics notice snackbar, opens Settings > Privacy -->
    <string name="home_analytics_notice_action">Settings</string>
</resources>
