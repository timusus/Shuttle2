<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Content description: collapses the full-screen player back to the mini player -->
    <string name="player_collapse">Collapse player</string>
    <!-- Accessibility action on the song row that heads the full-screen player while the queue or another panel is open: closes the panel, back to the full player -->
    <string name="player_now_playing">Now playing</string>
    <!-- Button in the full-screen player's bottom row that opens and closes the queue -->
    <string name="player_queue">Queue</string>
    <!-- Small label under the full-screen player's Playback & sound button (the waveform icon) -->
    <string name="player_bar_sound">Sound</string>
    <!-- Small label under the full-screen player's sleep timer button -->
    <string name="player_bar_sleep">Sleep</string>
    <!-- Small label under the full-screen player's audio output button -->
    <string name="player_bar_output">Output</string>
    <!-- Small label under the full-screen player's overflow menu button -->
    <string name="player_bar_more">More</string>
    <!-- Over the queue: what it was started from, which a tap opens; %1$s is an album, artist, playlist or genre name -->
    <string name="queue_playing_from">Playing from %1$s</string>
    <!-- Content description of the queue header's button that saves the queue as a playlist -->
    <string name="queue_save_as_playlist">Save as playlist</string>
    <!-- Under the queue's "Up Next" divider: how many songs follow the current one and how long they play for; %2$s is a length such as "12:30" -->
    <plurals name="queue_up_next_summary">
        <item quantity="one">%1$d song · %2$s left</item>
        <item quantity="other">%1$d songs · %2$s left</item>
    </plurals>
    <!-- Snackbar shown after the queue is cleared -->
    <string name="player_queue_cleared">Queue cleared</string>
    <!-- Snackbar action that puts a cleared queue back -->
    <string name="player_undo">Undo</string>
    <!-- Content description of the button that casts to another device -->
    <string name="player_cast">Cast</string>
    <!-- Stands in for the name of the Cast device playback plays on, where the Cast session doesn't give one: "Playing on your Cast device". -->
    <string name="player_cast_device">your Cast device</string>
    <string name="player_output">Audio output</string>
    <!-- Content description of the button that seeks an audiobook or podcast back, replacing Previous -->
    <string name="player_seek_backward">Seek backward</string>
    <!-- Content description of the button that seeks an audiobook or podcast forward, replacing Next -->
    <string name="player_seek_forward">Seek forward</string>
    <!-- Content description of the sleep timer button while a timer runs -->
    <string name="player_sleep_timer_on">Sleep timer on</string>
    <!-- Content description of the button that opens the sleep timer -->
    <string name="player_sleep_timer">Sleep timer</string>
    <!-- Title of the sleep timer's length slider -->
    <string name="player_sleep_timer_length">Length</string>
    <!-- Button that starts the sleep timer -->
    <string name="player_sleep_timer_start">Start timer</string>
    <!-- Button that adds time to a running sleep timer; %1$s is a length such as "5 min" -->
    <string name="player_sleep_timer_extend">Add %1$s</string>
    <!-- The running sleep timer's countdown once its time is up and it waits for the song to finish -->
    <string name="player_sleep_timer_track_end">End of song</string>
    <!-- Title of the playback speed slider in Playback & sound -->
    <string name="player_speed">Speed</string>
    <!-- A playback speed; %1$s is a number such as "1.25" -->
    <string name="player_speed_value">%1$s×</string>
    <!-- Content description of the Now Playing chip showing a non-normal speed; %1$s is a speed such as "1.25×" -->
    <string name="player_speed_description">Playback speed %1$s</string>
    <!-- Link from Now Playing's Playback & sound to the rest of those settings -->
    <string name="player_more_sound_settings">More sound settings</string>
    <!-- Summary of the link to the rest of the Playback & sound settings -->
    <string name="player_more_sound_settings_summary">Pre-amp, USB audio output and shuffle</string>
    <!-- Snackbar shown after a song is removed from the queue -->
    <string name="player_removed_from_queue">Removed from queue</string>
    <!-- Snackbar shown when a queued song is skipped because streaming it needs Shuttle Music Pro; %1$s is the song title -->
    <string name="player_server_song_skipped">Skipped “%1$s” — streaming needs Shuttle Music Pro</string>
    <!-- Song menu option: opens the song's album -->
    <string name="player_go_to_album">Go to album</string>
    <!-- Song menu option: opens the song's album artist -->
    <string name="player_go_to_artist">Go to artist</string>
    <!-- Button that creates the playlist named in the New Playlist dialog -->
    <string name="player_create_playlist">Create</string>
    <!-- Snackbar after a media server rejects the saved sign-in mid-session; %1$s is the server's name, such as Jellyfin -->
    <string name="shell_server_signed_out">Signed out of %1$s</string>
    <!-- Snackbar action that opens the server's sign-in dialog -->
    <string name="shell_server_sign_in">Sign in</string>
</resources>
