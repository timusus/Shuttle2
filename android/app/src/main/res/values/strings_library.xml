<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title for the list of artists -->
    <string name="artists">Artists</string>
    <!-- Title for the list of albums -->
    <string name="albums">Albums</string>
    <plurals name="albumsPlural">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> album</item>
        <item quantity="other"><xliff:g example="5" id="count">%1$d</xliff:g> albums</item>
    </plurals>
    <!-- Title for the list of songs -->
    <string name="songs">Songs</string>
    <!-- The number of songs for an album/playlist/genre -->
    <plurals name="songsPlural">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> song</item>
        <item quantity="other"><xliff:g example="12" id="count">%1$d</xliff:g> songs</item>
    </plurals>
    <!-- Title for the list of genres -->
    <string name="genres">Genres</string>
    <!-- Shown when the folder list finishes loading, and there are no songs on the device -->
    <string name="folder_list_empty">No folders</string>
    <!-- Name of the device's internal storage, shown as a top level folder -->
    <string name="folders_internal_storage">Internal storage</string>
    <!-- Name of the folder holding songs whose location on the device is unknown -->
    <string name="folders_other">Other locations</string>
    <!-- Name of the device's root filesystem, shown as a top level folder when a song's storage volume can't be determined -->
    <string name="folders_root">Root</string>
    <!-- Content description for the button that goes up to the parent folder -->
    <string name="folders_navigate_up">Up one folder</string>
    <!-- Title for the list of playlists -->
    <string name="library_playlists">Playlists</string>
    <!-- Shown when the app is scanning for songs in the library -->
    <string name="library_scan_in_progress">Scanning your library</string>
    <!-- Shown on the library screen, if the user has manually deselected all the library tabs in appearance settings-->
    <string name="library_tabs_empty">No library tabs visible</string>
    <!-- Content description the song context menu icon -->
    <string name="song_context_menu">Song context menu</string>
    <!-- Content description for an artwork image. -->
    <string name="artwork">Artwork</string>
    <!-- Content description the selection mark image in a list. -->
    <string name="selection_mark">Selection mark</string>
    <!-- Library top bar subtitle on the Artists tab -->
    <plurals name="library_count_artists">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> artist</item>
        <item quantity="other"><xliff:g example="12" id="count">%1$d</xliff:g> artists</item>
    </plurals>
    <!-- Library top bar subtitle on the Genres tab -->
    <plurals name="library_count_genres">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> genre</item>
        <item quantity="other"><xliff:g example="12" id="count">%1$d</xliff:g> genres</item>
    </plurals>
    <!-- Library top bar subtitle on the Playlists tab -->
    <plurals name="library_count_playlists">
        <item quantity="one"><xliff:g example="1" id="count">%1$d</xliff:g> playlist</item>
        <item quantity="other"><xliff:g example="12" id="count">%1$d</xliff:g> playlists</item>
    </plurals>
    <!-- Library overflow item: opens the sheet that shows, hides and reorders the library tabs -->
    <string name="library_edit_tabs">Edit tabs</string>
    <!-- Edit tabs sheet: move a tab one place earlier -->
    <string name="library_tab_move_up">Move up</string>
    <!-- Edit tabs sheet: move a tab one place later -->
    <string name="library_tab_move_down">Move down</string>
    <!-- Content description of the Library top bar's overflow button -->
    <string name="library_more_options">More options</string>
    <!-- Content description of the up button on detail screens and folders -->
    <string name="library_navigate_up">Navigate up</string>
    <!-- Library tab label for folders -->
    <string name="library_tab_folders">Folders</string>
    <!-- Playlists tab: section over the built-in smart playlists -->
    <string name="library_smart_playlists">Smart playlists</string>
    <!-- Playlist detail: hint shown instead of drag handles when the playlist isn't in custom order -->
    <string name="playlist_detail_reorder_hint">Sorted by <xliff:g example="Song name" id="sort">%1$s</xliff:g>. Choose Custom to reorder.</string>
    <!-- Selection toolbar / playlist actions: remove the selected songs from this playlist (the files are kept) -->
    <string name="playlist_detail_remove">Remove from playlist</string>
    <!-- Artist detail section over the artist's albums -->
    <string name="artist_detail_albums">Albums</string>
    <!-- Artist detail section over the artist's songs -->
    <string name="artist_detail_songs">Songs</string>
    <!-- Detail screen action: shuffle the artist's albums in album order -->
    <string name="detail_shuffle_albums">Shuffle albums</string>
    <!-- Snackbar shown when Shuffle albums couldn't start playback -->
    <string name="shuffle_albums_failed">Couldn\'t shuffle albums: <xliff:g example="File not found" id="reason">%1$s</xliff:g></string>
    <!-- Library empty state when every tab is hidden -->
    <string name="library_all_tabs_hidden">Every tab is hidden</string>
    <!-- Disc header on album detail -->
    <string name="album_detail_disc">Disc <xliff:g example="1" id="disc">%1$d</xliff:g></string>
    <!-- Detail screen shown for a key that no longer exists in the library -->
    <string name="library_item_not_found">Not in your library</string>
    <string name="library_detail_placeholder">Pick something to see it here</string>
</resources>
