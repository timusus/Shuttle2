<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Shown when text is required in a text field -->
    <string name="validation_field_required">需要填写</string>
    <!-- Shown when an unexpected error occurs -->
    <string name="error_unexpected">发生预料之外的错误</string>
    <!-- Shown when an unknown error occurs -->
    <string name="error_unknown">发生了一个未知错误</string>
    <!-- Shown when songs are added to the queue -->
    <plurals name="queue_songs_added">
        <item quantity="other">已将 <xliff:g example="30" id="count">%1$d</xliff:g> 首歌曲添加至播放队列</item>
    </plurals>
    <!-- Shown when current playback queue is added to a playlist -->
    <string name="playlist_queue_added">已将播放队列添加至 <xliff:g example="Favourites" id="playlist_name">%1$s</xliff:g> 播放列表</string>
    <!-- Shown when songs are added to a playlist -->
    <plurals name="playlist_songs_added">
        <item quantity="other">已添加 <xliff:g example="30" id="count">%1$d</xliff:g> 首歌曲至 <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when albums are added to a playlist -->
    <plurals name="playlist_albums_added">
        <item quantity="other">已添加 <xliff:g example="30" id="count">%1$d</xliff:g> 张专辑至 <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when artists are added to a playlist -->
    <plurals name="playlist_artists_added">
        <item quantity="other">已添加 <xliff:g example="30" id="count">%1$d</xliff:g> 名艺术家至 <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- Shown when genres are added to a playlist -->
    <plurals name="playlist_genres_added">
        <item quantity="other">已添加 <xliff:g example="30" id="count">%1$d</xliff:g> 个流派至 <xliff:g example="Favourites" id="playlist_name">%2$s</xliff:g></item>
    </plurals>
    <!-- The disc number for this album-->
    <string name="disc_number">CD <xliff:g example="1" id="disc_number">%1$d</xliff:g></string>
    <!-- Shown when the songs list finishes loading, and there are no songs-->
    <string name="song_list_empty">没有歌曲</string>
    <!-- Shown when the albums list finishes loading, and there are no songs-->
    <string name="album_list_empty">没有专辑</string>
    <!-- Shown when the artists list finishes loading, and there are no songs-->
    <string name="artist_list_empty">没有艺术家</string>
    <!-- Shown when the genres list finishes loading, and there are no songs-->
    <string name="genre_list_empty">没有流派</string>
    <!-- Shown when the playlists list finishes loading, and there are no songs-->
    <string name="playlist_list_empty">没有播放列表</string>
    <!-- Button to skip to the next track -->
    <string name="button_skip_next">下一首</string>
    <!-- Button to play/pause the current song-->
    <string name="button_toggle_playback">切换播放</string>
    <!-- Button to skip to the previous track-->
    <string name="button_skip_previous">上一首</string>
    <!-- Shown when the playback queue is empty -->
    <string name="queue_empty">队列空</string>
</resources>
