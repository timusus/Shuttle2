<?xml version="1.0" encoding="utf-8"?>
<!-- The scrim behind text and buttons drawn over artwork. Its bottom corners follow the widget's below API 31,
     where the widget can't clip them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_scrim" />
    <corners
        android:bottomLeftRadius="@dimen/widget_background_radius"
        android:bottomRightRadius="@dimen/widget_background_radius"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp" />
</shape>
