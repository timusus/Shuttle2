<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The title of 'settings' in the bottom settings menu -->
    <string name="settings_menu_settings">Impostazioni</string>
    <!-- Settings option to clear (delete) all existing artwork -->
    <string name="settings_dialog_title_clear_artwork">Rimuovi illustrazioni</string>
    <!-- Button shown to confirm clearing (deleting) of existing artwork -->
    <string name="settings_dialog_button_clear_artwork">Elimina</string>
    <!-- Dialog warning shown when user selects option to clear (delete) existing artwork -->
    <string name="settings_dialog_message_clear_artwork">Questo rimuoverà definitivamente tutte le illustrazioni memorizzate nella cache</string>
    <!-- Settings option to download all artwork (album/artist images)-->
    <string name="settings_dialog_title_download_artwork">Scarica tutte le illustrazioni</string>
    <!-- Shown when user selects option to download all artwork (album/artist images) -->
    <string name="settings_dialog_message_download_artwork">Questo scaricherà tutte le illustrazioni, indipendentemente dalla connessione di rete (WiFi/dati/altro)</string>
    <!-- Option to confirm downloading of artwork (album/artist images) -->
    <string name="settings_dialog_button_download_artwork">Scarica</string>
    <!-- The name of the debug logs, as the share subject and the live log's clip label -->
    <string name="settings_logging_name">Registri log di Shuttle Music</string>
    <!-- Error message shown when sharing debug logs failed, because there are no logs -->
    <string name="settings_logging_logs_empty">File di log vuoto</string>
    <!-- Settings: Title for 'appearance' settings (settings related to themes, etc.) -->
    <string name="pref_category_title_display">Aspetto</string>
    <!-- Settings: Title for artwork related settings (artist/album images) -->
    <string name="pref_category_title_artwork">Illustrazioni</string>
    <!-- Settings: Title for widget related settings  -->
    <string name="pref_category_title_widgets">Widget</string>
    <!-- Settings: Title for privacy related settings -->
    <string name="pref_category_title_privacy">Privacy</string>
    <!-- Settings: Title for changing the theme -->
    <string name="pref_theme_title">Tema</string>
    <!-- Settings: Title for changing the accent colour -->
    <string name="pref_theme_accent_title">Colore principale</string>
    <!-- Settings: Title for the option to rescan the media library -->
    <string name="pref_media_rescan_title">Nuova scansione</string>
    <!-- Settings: Description for the option to rescan the media library -->
    <string name="pref_media_rescan_summary">Nuova scansione dei fornitori selezionati</string>
    <!-- Settings: Title for the category holding library backup and restore -->
    <string name="pref_category_title_backup">Backup</string>
    <!-- Settings: Title for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_title">Esegui backup della libreria</string>
    <!-- Settings: Description for the option to back up play counts, favourites and playlists to a file -->
    <string name="pref_backup_export_summary">Salva in un file i conteggi di riproduzione, i preferiti, le esclusioni, le playlist e le tue impostazioni</string>
    <!-- Settings: Title for the option to restore a library backup from a file -->
    <string name="pref_backup_import_title">Ripristina backup della libreria</string>
    <!-- Settings: Description for the option to restore a library backup from a file -->
    <string name="pref_backup_import_summary">Unisce un backup alla tua libreria e sostituisce le impostazioni con quelle in esso contenute</string>
    <!-- Settings: Snackbar shown once a library backup has been saved to a file -->
    <string name="settings_backup_export_saved">Backup della libreria salvato</string>
    <!-- Settings: Snackbar shown when saving a library backup fails -->
    <string name="settings_backup_export_failed">Backup della libreria non riuscito</string>
    <!-- Settings: Snackbar shown when reading a library backup file fails -->
    <string name="settings_backup_import_failed">Impossibile leggere quel file di backup</string>
    <!-- Settings: Snackbar summarising a library backup restore; %1$s is the songs matched count (settings_backup_import_songs), %2$s the playlists added or updated count (settings_backup_import_playlists) -->
    <string name="settings_backup_import_done">Ripristino completato: %1$s, %2$s</string>
    <!-- Settings: Snackbar summarising a library backup restore when some songs were not found; %1$s is the songs matched count, %2$s the playlists count, %3$s the backup songs not found count -->
    <string name="settings_backup_import_done_unmatched">Ripristino completato: %1$s, %2$s; %3$s</string>
    <!-- Settings: Snackbar shown when a library backup restore matched no songs and added no playlists -->
    <string name="settings_backup_import_nothing">Niente in questo backup corrisponde alla tua libreria</string>
    <!-- Settings: Snackbar shown when a library backup restore restored the backup's settings but matched no songs and added no playlists -->
    <string name="settings_backup_import_settings_only">Impostazioni ripristinate; nessuna canzone o playlist in questo backup corrisponde alla tua libreria</string>
    <!-- Settings: Snackbar summarising a library backup restore that also restored the backup's settings; %1$s is the songs and playlists summary (settings_backup_import_done or settings_backup_import_done_unmatched) -->
    <string name="settings_backup_import_with_settings">%1$s; impostazioni ripristinate</string>
    <!-- Settings: Count of backup songs that matched the library during a restore -->
    <plurals name="settings_backup_import_songs">
        <item quantity="one">%1$d canzone corrispondente</item>
        <item quantity="other">%1$d canzoni corrispondenti</item>
    </plurals>
    <!-- Settings: Count of playlists added or updated during a restore -->
    <plurals name="settings_backup_import_playlists">
        <item quantity="one">%1$d playlist aggiunta o aggiornata</item>
        <item quantity="other">%1$d playlist aggiunte o aggiornate</item>
    </plurals>
    <!-- Settings: Count of backup songs not found in the library during a restore -->
    <plurals name="settings_backup_import_unmatched">
        <item quantity="one">%1$d canzone non trovata</item>
        <item quantity="other">%1$d canzoni non trovate</item>
    </plurals>
    <!-- Settings: Title for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_title">Esclusioni</string>
    <!-- Settings: Description for the option to view the list of excluded (blacklisted) songs -->
    <string name="pref_exclude_summary">Visualizza/Modifica esclusioni</string>
    <!-- Settings: Title for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_title">Solo con Wi-Fi</string>
    <!-- Settings: Description for the option to restrict artwork downloading to only work on Wi-Fi -->
    <string name="pref_artwork_wifi_subtitle">Scarica le illustrazioni da fonti remote solo quando il Wi-Fi è disponibile</string>
    <!-- Settings: Title for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_title">Solo locali</string>
    <!-- Settings: Description for the option to restrict artwork to only load from local sources -->
    <string name="pref_artwork_local_only_subtitle">Non scaricare le illustrazioni da fonti remote (online)</string>
    <!-- Settings: Title for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_title">Rimuovi illustrazioni</string>
    <!-- Settings: Description for the option to clear (delete) all artwork -->
    <string name="pref_clear_artwork_subtitle">Rimuove tutte le immagini memorizzate nella cache</string>
    <!-- Settings: Title for the option to download all artwork (artist/album images) -->
    <string name="pref_download_artwork_title">Scarica tutte le illustrazioni</string>
    <!-- Settings: Title for the option to change opacity of the widget background -->
    <string name="pref_widget_opacity_title">Opacità sfondo</string>
    <!-- Settings: Title for the option to view the changelog -->
    <string name="pref_view_changelog_title">Visualizza il changelog</string>
    <!-- Settings: Title for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_title">Segnalazione di arresti anomali</string>
    <!-- Settings: Description for the option to turn off crash reporting -->
    <string name="pref_crash_reporting_subtitle">Segnalazioni anonime degli arresti anomali per trovare e risolvere i bug</string>
    <!-- Settings: Title for the option to view open source licenses -->
    <string name="pref_view_licenses_title">Visualizza le licenze</string>
    <!-- Settings: Title for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_title">Salvataggio dei log</string>
    <!-- Settings: Description for the option to enable debug logging (log file will be stored on disk) -->
    <string name="pref_file_logging_subtitle">Scrive i log di Shuttle Music in un file sul disco</string>
    <!-- Settings: Title for the option to share the debug log file -->
    <string name="pref_share_debug_logs_title">Condividi i log di debug</string>
    <!-- Settings: Title for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_title">Immagine sessione</string>
    <!-- Settings: Description for the option to disable artwork from being associated with the 'media session'. Media Session is an Android concept, not sure how this would be translated. -->
    <string name="pref_media_session_artwork_subtitle">Fornisce la copertina dell\'album alla sessione multimediale di Android. Disabilita per nasconderla dalla schermata di blocco</string>
    <!-- Settings: Title for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_title">Mantieni la modalità casuale</string>
    <!-- Settings: Description for the option to disable shuffle when starting a new queue -->
    <string name="pref_disable_shuffle_on_queue_subtitle">Quando cambi la coda, la modalità casuale non viene disabilitata</string>
    <!-- Settings title for the day/night theme option -->
    <string name="theme_entry_day_night">Giorno/notte</string>
    <!-- Settings title for the light theme option -->
    <string name="theme_entry_light">Chiaro</string>
    <!-- Settings title for the dark theme option -->
    <string name="theme_entry_dark">Scuro</string>
    <!-- Settings title for blue theme option (called Shuttle blue, because it uses the particular shade of blue from the original Shuttle) -->
    <string name="theme_accent_entry_blue">Blu Shuttle</string>
    <!-- Settings title for the cyan theme option -->
    <string name="theme_accent_entry_cyan">Ciano</string>
    <!-- Settings title for the purple theme option -->
    <string name="theme_accent_entry_purple">Viola</string>
    <!-- Settings title for the green theme option -->
    <string name="theme_accent_entry_green">Verde</string>
    <!-- Settings title for the orange theme option -->
    <string name="theme_accent_entry_orange">Arancione</string>
</resources>
