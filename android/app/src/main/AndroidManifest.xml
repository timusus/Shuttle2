<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Deleting a device song's file up to Android 9; requested with READ_EXTERNAL_STORAGE (see MusicPermission). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 17 gates LAN access behind this at targetSdk 37; below that the system grants it with INTERNET and it
         is never requested at runtime (see LocalNetworkPermission). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>

    <application
        android:name=".ShuttleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.DayNight"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lists S2 as a music app, e.g. for the system's default music player setting -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Opens audio files from other apps (file managers, downloads, messaging apps) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
        </activity>

        <!-- Shortcut Handler Activity -->
        <activity
            android:name=".ui.ShortcutHandlerActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="com.simplecityapps.shuttle.shortcuts.TOGGLE_PLAYBACK" />
                <action android:name="com.simplecityapps.shuttle.shortcuts.SHUFFLE_ALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Sentry starts only once the user allows crash reporting (TelemetryConsentGate), never on its own.
             Its content providers would still run before Application.onCreate, so they are removed too. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />

        <service
            android:name=".ui.tile.PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_play_pause_24dp"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget -->

        <receiver
            android:name=".ui.widgets.WidgetProvider41"
            android:exported="true"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_small_info" />
        </receiver>

        <receiver
            android:name=".ui.widgets.WidgetProvider42"
            android:exported="true"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_large_info" />
        </receiver>

        <!-- Shares the debug log from Settings -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- androidx.startup runs ProfileInstallerInitializer, which installs the Baseline Profile on
             sideloaded APKs, and ProcessLifecycleInitializer, whose ProcessLifecycleOwner.init()
             drives MediaProviderInitializer's sync-on-return-to-app observer (#771). WorkManager is
             configured on demand through Configuration.Provider. -->

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
            <meta-data
                android:name="okhttp3.internal.platform.PlatformInitializer"
                tools:node="remove" />
        </provider>

    </application>

</manifest>