<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- seed-test-media.sh's skip-onboarding flow triggers this to import the seeded
             MediaStore tracks without walking through onboarding's Scanner page. DUMP is held by adb shell but not by third-party apps,
             so only adb can trigger it. -->
        <receiver
            android:name=".debug.DebugMediaImportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simplecityapps.shuttle.debug.ACTION_IMPORT_MEDIA" />
            </intent-filter>
        </receiver>

        <!-- support/scripts/s2-debug.sh drives playback and the queue through this receiver
             (see the debug-receivers skill). DUMP-protected like the import receiver above. -->
        <receiver
            android:name=".debug.DebugPlaybackReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simplecityapps.shuttle.debug.PLAY_ALL" />
                <action android:name="com.simplecityapps.shuttle.debug.PLAY" />
                <action android:name="com.simplecityapps.shuttle.debug.PAUSE" />
                <action android:name="com.simplecityapps.shuttle.debug.NEXT" />
                <action android:name="com.simplecityapps.shuttle.debug.PREV" />
                <action android:name="com.simplecityapps.shuttle.debug.SEEK" />
                <action android:name="com.simplecityapps.shuttle.debug.REMOVE_QUEUE_ITEM" />
                <action android:name="com.simplecityapps.shuttle.debug.REMOVE_PLAYLIST_SONG" />
                <action android:name="com.simplecityapps.shuttle.debug.REORDER_QUEUE" />
                <action android:name="com.simplecityapps.shuttle.debug.SHUFFLE" />
                <action android:name="com.simplecityapps.shuttle.debug.REPEAT" />
                <action android:name="com.simplecityapps.shuttle.debug.SPEED" />
                <action android:name="com.simplecityapps.shuttle.debug.SLEEP_TIMER" />
                <action android:name="com.simplecityapps.shuttle.debug.DUMP_STATE" />
            </intent-filter>
        </receiver>

        <!-- seed-remote-provider.sh signs in to a Jellyfin or Emby test server with an API key
             instead of a typed password. Same DUMP guard as above. -->
        <receiver
            android:name=".debug.DebugRemoteProviderReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simplecityapps.shuttle.debug.ACTION_SEED_REMOTE_PROVIDER" />
            </intent-filter>
        </receiver>

        <!-- Downloads and removes songs for offline playback until the UI for it lands (#88).
             Replies on S2Debug like DebugPlaybackReceiver; same DUMP guard. -->
        <receiver
            android:name=".debug.DebugDownloadReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simplecityapps.shuttle.debug.DOWNLOAD_SONG" />
                <action android:name="com.simplecityapps.shuttle.debug.REMOVE_DOWNLOAD" />
                <action android:name="com.simplecityapps.shuttle.debug.DOWNLOAD_WIFI_ONLY" />
                <action android:name="com.simplecityapps.shuttle.debug.DUMP_DOWNLOADS" />
            </intent-filter>
        </receiver>

        <!-- Overrides the resolved entitlement (Free/Trial/Pro) for paywall UI checks on the emulator,
             without a real purchase or trial (#418). Same DUMP guard as above. -->
        <receiver
            android:name=".debug.DebugEntitlementReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simplecityapps.shuttle.debug.SET_ENTITLEMENT" />
            </intent-filter>
        </receiver>

        <!-- The design system catalogue (#374): boards for review on device, with motion, touch
             and dynamic colour. Debug builds only. No LAUNCHER category: a second launcher activity
             takes over the package's default launch intent, which Maestro's launchApp uses (#392).
             Open it with `adb shell am start -n com.simplecityapps.shuttle.dev/com.simplecityapps.shuttle.designsystem.catalog.DesignCatalogActivity`. -->
        <activity
            android:name="com.simplecityapps.shuttle.designsystem.catalog.DesignCatalogActivity"
            android:exported="true"
            android:label="S2 Catalog"
            android:taskAffinity="com.simplecityapps.shuttle.catalog"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

    </application>

</manifest>
